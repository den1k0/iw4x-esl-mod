#include "ui/menudef.h"
#include "ui_mp/common_macro.inc"

#define CHOICE_SIZE_X			150
#define CHOICE_SIZE_Y			22

#define CHOICE_X_START			0
#define CHOICE_Y_START			0

#include "ui_mp/menustyle.inc"
#include "ui/choices_setup_common.menu"

{
	menuDef
	{
		name			"changeclass_marines_mw"
		rect			0 0 640 480
		focuscolor		COLOR_FOCUSED
		style			WINDOW_STYLE_FILLED
		blurWorld		7.0

		onEsc 
		{
			scriptMenuResponse "back";
		}

		#include "ui_mp/emzui/ingamebg.inc"

		itemDef
		{
			rect 48 30 0 0
			text			"Class"
			textfont		UI_FONT_NORMAL
			forecolor       COLOR_TITLE
			textscale		TEXTSIZE_TITLE
			textStyle 		6
			visible			1
			decoration
		}

		#define BACK_OPEN	;
		#include "ui_mp/navcontrols.inc"
		
		#define BUTTON_DBUTTON_AL(itemNum,name,response) \
		CHOICE_BUTTON_BG( itemNum, 0 ) \
		CHOICE_HIGHLIGHT( itemNum, 0 ) \
		CHOICE_BUTTON_VIS_NOHI( itemNum, itemNum + ". " + name,scriptMenuResponse response;, when( dvarBool( "allies_allow_" + response ) || dvarString( loadout_curclass ) == response ) ) \
		CHOICE_DBUTTON_VIS_NOHI( itemNum, itemNum + ". " + name, when( !dvarBool( "allies_allow_" + response ) && dvarString( loadout_curclass ) != response ) )
		
		// NOTE (ESL-MOD): the demolitions class type is stripped - ESL plays with
		// assault / SMG / sniper only.  Re-add a BUTTON_DBUTTON_AL line here
		// (and the matching execKey below) if you ever want it back.
		// NOTE (ESL-MOD): the second label is cosmetic only - the response string
		// stays "specops" because the script/menu logic keys off it.
		BUTTON_DBUTTON_AL(1,"Assault","assault")
		BUTTON_DBUTTON_AL(2,"SMG","specops")
		BUTTON_DBUTTON_AL(3,"Sniper","sniper")

		CHOICE_BUTTON_BG( 6, 0 )
		CHOICE_HIGHLIGHT( 6, 0 )		
		CHOICE_BUTTON_NOHI( 6, "4. Spectate Team", scriptMenuResponse "killspec"; )
		
		execKey "1" { scriptMenuResponse "assault"; }
		execKey "2" { scriptMenuResponse "specops"; }
		execKey "3" { scriptMenuResponse "sniper"; }
		execKey "4" { scriptMenuResponse "killspec"; }
	}
}
#include "ui/safearea_hd.menu"