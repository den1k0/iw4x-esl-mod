#include "ui/menudef.h"
#include "ui_mp/common/redux.inc"

//  ESL-MOD end-of-match map vote
//
//  Layout and card geometry are the ones the "sesh_server_v2" map vote uses: three
//  map cards and a "Random Map" card, each showing the map's preview image, its
//  name and its vote count.  The engine behind them is this mod's own (esl_mapVote
//  in _esl.gsc) - that mod ships no script at all, and nothing in IW4x implements
//  the dvars its menu reads.
//
//  Read from the server, all of it published by esl_mapVote():
//
//      map_vote_id_0 .. map_vote_id_2      map name of each candidate (a key in
//                                          tables\esl_mapvote.csv)
//      map_vote_count_0 .. count_2         votes for that candidate
//      map_vote_count_4                    votes for "Random Map"
//      esl_vote_timer                      the line under the title, e.g.
//                                          "Vote ends in 12 s"
//
//  Picking a card answers the server with "cast_vote:<slot>", where slot 0-2 is a
//  map and 4 is the random card (3 is unused on purpose: the slot numbers are the
//  ones sesh's menu uses, so the two are easy to compare).
//
//  The preview materials (preview_mp_*, preview_mp_random) come from mod.ff, which
//  the mod ships next to the .iwd; the images they draw are the game's own
//  (images\preview_mp_*.iwi, already in main\iw_02.iwd and iw4x_01.iwd).

#define MENU_NAME                   "map_vote"

// The cards are drawn on this dvar: 0 while the round-end scoreboard is still up
// (the vote's own delay, with "Next map vote starts in a moment" under the title),
// 1 once the vote is live.
//
// Why the menu cannot simply be opened later instead: the client only shows a
// script menu that was opened before the game's end-of-match sequence put the
// players into intermission.  Opened after that, the menu is never displayed at
// all ("when everyone goes into spectator mode to vote map - no vote menu
// appears"), so the server opens it at the end of the last round and reveals the
// cards with this.
#define MAP_VOTE_READY              ( dvarInt( "esl_vote_ready" ) == 1 )

menudef
{
	name                            MENU_NAME
	rect                            0 0 640 480 4 4
	forecolor                       1 1 1 1
	blurWorld                       7
	onOpen
	{
		// NOTE: the input focus cannot be taken from here.
		//
		// A script menu the server opens is *drawn* but takes no input: the keyboard
		// keeps going to the game and there is no cursor.  An exec of the command
		// ESC is bound to does not exist in this build either (there is no
		// "togglemenu" in iw4x.exe), so it silently broke this whole block - which
		// is what made the vote disappear entirely for one build.
		//
		// What does work is the player opening the in-game menu: the client's UI
		// takes focus, the cursor appears, and the cards - drawn over that menu -
		// become clickable.  That is what the hint under the title tells them to do.
		//
		// NOTE: the highlight is deliberately *not* reset here, so the re-opens the
		// server does while the players arrive cannot wipe the player's own pick.

		// Tells the server this menu is really on screen.  The server cannot see
		// that for itself, and it is the difference between "the client did not
		// show the menu" and "the menu is up but the keys do nothing".
		scriptMenuResponse "menu_opened";

		// NOTE: the long vote sound is not played here but by the server, when it
		// reveals the cards.  The end of a match resets this menu (the killcam and
		// the intermission transition), so the server keeps re-opening it until it
		// sticks, and playing it here would restart the sound on every attempt.

		exec "-scores";
	}
	onEsc
	{
		close "self";
		exec "+scores";
	}

	#define CARD_WIDTH              175.5
	#define CARD_HEIGHT             98.71875
	#define CARD_ROW( idx )         ( ( idx - 0 ) % 3 )
	#define CARD_COL( idx )         ( ( idx - 0 - ( ( idx - 0 ) % 3 ) ) / 3 )

	#define CARD_X( idx )           ( 0 + ( CARD_WIDTH + 5 ) * CARD_COL( idx ) )
	#define CARD_Y( idx )           ( 55 + ( CARD_HEIGHT + 5 ) * CARD_ROW( idx ) )
	#define CARD_ORIGIN( idx )      CARD_X( idx ) CARD_Y( idx )
	#define CARD_RECT( idx )        CARD_ORIGIN( idx ) CARD_WIDTH CARD_HEIGHT 1 1

	#define MAP_VOTE_CARD( idx, int_fix ) \
			CREATE_SHADER_VIS( CARD_RECT( idx ), "white", 0 0 0 1, MAP_VOTE_READY ) \
			CREATE_SHADER_VIS( CARD_RECT( idx ), tableLookup( "tables/esl_mapvote.csv", 0, dvarString( "map_vote_id_" + idx ), 1 ), 1 1 1 0.65, MAP_VOTE_READY ) \
			CREATE_SHADER_VIS( CARD_RECT( idx ), "gradient_bottom", 0 0 0 0.35, MAP_VOTE_READY ) \
			itemDef \
			{ \
				rect                        CARD_RECT( idx ) \
				forecolor                   1 1 1 0 \
				border                      1 \
				bordersize                  1 \
				bordercolor                 0.3 0.3 0.3 1 \
				exp                         material ( "white" ) \
				style                       3 \
				type                        1 \
				visible                     when ( MAP_VOTE_READY ) \
				onFocus \
				{ \
					play                    "mouse_over"; \
					setItemColor            self forecolor 1 0 0 0.24 \
				} \
				leaveFocus \
				{ \
					setItemColor            self forecolor 1 0 0 0 \
				} \
				action \
				{ \
					play                    "mouse_click"; \
					setlocalVarInt          "map_vote_id" idx; \
					scriptMenuResponse      "cast_vote:" int_fix; \
				} \
			} \
			CREATE_SHADER_EX( CARD_RECT( idx ), "white", 1 1 1 0.1, localVarInt( "map_vote_id" ) == idx && MAP_VOTE_READY, border 0; bordersize 0.5; bordercolor 1 0.823 0 1 ) \
			CREATE_TEXT( CARD_RECT( idx ), tableLookup( "tables/esl_mapvote.csv", 0, dvarString( "map_vote_id_" + idx ), 2 ), 1 1 1 1, MAP_VOTE_READY, textstyle 3; textscale 0.375; textalign 12; origin 5 -15 ) \
			CREATE_TEXT( CARD_RECT( idx ), dvarString( "map_vote_count_" + idx ) + " vote", 1 1 1 0.5, dvarInt( "map_vote_count_" + idx ) == 1 && MAP_VOTE_READY, textstyle 3; textscale 0.275; textalign 12; origin 5 -4.5 ) \
			CREATE_TEXT( CARD_RECT( idx ), dvarString( "map_vote_count_" + idx ) + " votes", 1 1 1 0.5, dvarInt( "map_vote_count_" + idx ) != 1 && MAP_VOTE_READY, textstyle 3; textscale 0.275; textalign 12; origin 5 -4.5 )

	#define MAP_VOTE_RANDOM_CARD( idx, int_fix ) \
			CREATE_SHADER_VIS( CARD_RECT( idx ), "white", 0 0 0 1, MAP_VOTE_READY ) \
			CREATE_SHADER_VIS( CARD_RECT( idx ), "preview_mp_random", 1 1 1 0.65, MAP_VOTE_READY ) \
			CREATE_SHADER_VIS( CARD_RECT( idx ), "gradient_bottom", 0 0 0 0.35, MAP_VOTE_READY ) \
			itemDef \
			{ \
				rect                        CARD_RECT( idx ) \
				forecolor                   1 1 1 0 \
				border                      1 \
				bordersize                  1 \
				bordercolor                 0.3 0.3 0.3 1 \
				exp                         material ( "white" ) \
				style                       3 \
				type                        1 \
				visible                     when ( MAP_VOTE_READY ) \
				onFocus \
				{ \
					play                    "mouse_over"; \
					setItemColor            self forecolor 1 0 0 0.24 \
				} \
				leaveFocus \
				{ \
					setItemColor            self forecolor 1 0 0 0 \
				} \
				action \
				{ \
					play                    "mouse_click"; \
					setlocalVarInt          "map_vote_id" idx; \
					scriptMenuResponse      "cast_vote:" int_fix; \
				} \
			} \
			CREATE_SHADER_EX( CARD_RECT( idx ), "white", 1 1 1 0.1, localVarInt( "map_vote_id" ) == idx && MAP_VOTE_READY, border 0; bordersize 0.5; bordercolor 1 0.823 0 1 ) \
			CREATE_TEXT( CARD_RECT( idx ), "Random Map", 1 1 1 1, MAP_VOTE_READY, textstyle 3; textscale 0.375; textalign 12; origin 5 -15 ) \
			CREATE_TEXT( CARD_RECT( idx ), dvarString( "map_vote_count_" + idx ) + " vote", 1 1 1 0.5, dvarInt( "map_vote_count_" + idx ) == 1 && MAP_VOTE_READY, textstyle 3; textscale 0.275; textalign 12; origin 5 -4.5 ) \
			CREATE_TEXT( CARD_RECT( idx ), dvarString( "map_vote_count_" + idx ) + " votes", 1 1 1 0.5, dvarInt( "map_vote_count_" + idx ) != 1 && MAP_VOTE_READY, textstyle 3; textscale 0.275; textalign 12; origin 5 -4.5 )

	#define MINI_GLOW_UTIL \
		itemDef { name"glowing_util" rect 0 0 640 480 4 4; style 3; decoration; visible 1; foreColor 1 0 0 0; background "mockup_bg_glow"; textscale 0.55; exp foreColor a (((sin(milliseconds() / 1500) + 1) * 0.25) + 0.25) }

	itemDef
	{
		rect 0 0 272 28 1 1
		decoration
		visible 1
		forecolor 1 1 1 1
		textfont 9
		textalign 6
		textalignx -60
		textscale 0.5
		text "Next map"
	}

	MINI_GLOW_UTIL
	MAP_VOTE_CARD( 0, "0" )
	MAP_VOTE_CARD( 1, "1" )
	MAP_VOTE_CARD( 2, "2" )
	MAP_VOTE_RANDOM_CARD( 4, "4" )

	itemDef
	{
		rect 130 95 272 28 0 0
		style 0
		border 0
		ownerdraw 0
		ownerdrawFlag 0
		borderSize 0
		foreColor 1 1 1 1
		backColor 0 0 0 0
		borderColor 0 0 0 0
		outlineColor 0 0 0 0
		decoration
		type 0
		align 0
		textAlign 0
		textAlignX 200
		textAlignY 150
		textScale 0.5
		textStyle 3
		textFont 9
		feeder 0
		visible 1
		exp text (dvarString( "esl_vote_timer" ))
	}

	itemDef
	{
		rect 0 30 272 20 1 1
		decoration
		visible when ( MAP_VOTE_READY )
		forecolor 1 1 1 0.7
		textfont 9
		textalign 6
		textalignx -60
		textscale 0.375
		text "Press ESC, then click a card (4 = Random Map)"
	}

	// The hotkeys.  The cards above answer the mouse and the focus, but in the
	// postgame there is no cursor on screen and nothing is focused, so a card could
	// not be picked at all - "the screen came up but it would not let me vote".
	// These are menu-level hotkeys, exactly how the rest of this mod's in-game menus
	// are driven: the game's own changeclass menus bind their number keys this way
	// (execKey "1" { scriptMenuResponse "assault"; } in changeclass_mw.menu), and so
	// does this mod's create-a-class editor (execKey "1" in cac_ingame.inc).
	//
	// The key is a quoted string, as in both of those.  Unquoted, as this first was,
	// the key never fired - the menu drew and nothing answered it.
	//
	// Keys 1-3 are the three candidates and 4 is "Random Map"; the numbers inside
	// the responses are the slots the server counts (0-2 and 4).
	// Each one answers twice: "key_pressed" first, so the server log can tell
	// "the key never reached the menu" from "the menu answered and the answer was
	// not a vote", and then the vote itself.
	execKey "1" { play "mouse_click"; setlocalVarInt "map_vote_id" 0; scriptMenuResponse "key_pressed:1"; scriptMenuResponse "cast_vote:0"; }
	execKey "2" { play "mouse_click"; setlocalVarInt "map_vote_id" 1; scriptMenuResponse "key_pressed:2"; scriptMenuResponse "cast_vote:1"; }
	execKey "3" { play "mouse_click"; setlocalVarInt "map_vote_id" 2; scriptMenuResponse "key_pressed:3"; scriptMenuResponse "cast_vote:2"; }
	execKey "4" { play "mouse_click"; setlocalVarInt "map_vote_id" 4; scriptMenuResponse "key_pressed:4"; scriptMenuResponse "cast_vote:4"; }
}
