// =============================================================================
//  ESL-MOD  --  competitive rule enforcement for IW4x / Call of Duty: MW2
//
//  Entry point : esl_init(), called from the overridden
//                maps\mp\gametypes\_globallogic.gsc (every gametype main()
//                funnels through _globallogic::init()).
//
//  IMPORTANT - this file is NOT shipped as its own script.  The build step
//  (tools/dev/build_payload.ps1) appends it to the game's own _globallogic.gsc,
//  minus the #include lines (the host file already includes the same headers).
//  The mod therefore ships exactly one script and never references a script
//  file that the engine did not already know about, which removes any risk of
//  an unresolved cross-file call breaking level initialisation.
//
//  Everything is enforced SERVER SIDE.  A player cannot bypass a rule by
//  editing their own config or by tampering with the create-a-class menu,
//  because the class data is re-sanitised and the loadout is re-applied
//  whenever the server sees something that is not allowed.
//
//  Rules
//  -----
//    * no killstreaks      -> scr_game_hardpoints 0, stored killstreaks cleared
//    * no deathstreaks     -> death streak counter clamped to 0, any death
//                             streak perk is removed on spawn
//    * no perks            -> scr_game_perks 0 (native engine support) plus all
//                             stored perk slots cleared
//    * limited attachments -> whitelist, driven by esl_attach_* dvars
//    * limited weapons     -> optional base weapon denylist
//    * limited equipment   -> optional lethal / tactical whitelist
//
//  Configuration: see docs/CONFIG.md (all dvars are prefixed with "esl_")
// =============================================================================

#include common_scripts\utility;
#include maps\mp\_utility;
#include maps\mp\gametypes\_hud_util;


// =============================================================================
//  ENTRY POINT
// =============================================================================

esl_init()
{
	// Defensive: the hook runs once per game type startup, but a stray double
	// call must not start two sets of monitor threads.
	if ( isDefined( level.eslInitialized ) )
		return;

	level.eslInitialized = true;

	println( "^2[ESL-MOD]^7 loading" );

	// -------------------------------------------------------------------------
	//  This is the ONLY work done while the level is initialising, so it is
	//  deliberately reduced to getDvar()/setDvar() calls.  A script error in
	//  level init aborts the game type, which leaves the client hanging on
	//  "waiting for response" - so nothing that can fail is allowed here.
	//
	//  Setting the two native dvars must happen synchronously because
	//  _gamelogic.gsc reads scr_game_hardpoints when the game type starts.
	// -------------------------------------------------------------------------
	if ( esl_ruleOn( "esl_no_killstreaks" ) )
	{
		setDvar( "scr_game_hardpoints", 0 );
		level.killstreakRewards = 0;
	}

	if ( esl_ruleOn( "esl_no_perks" ) )
		setDvar( "scr_game_perks", 0 );

	// Search & Destroy match format (win limit / round switch / defuse time).
	// Also synchronous for the same reason as the two above: sd.gsc::main()
	// calls updateGametypeDvars(), which reads scr_sd_defusetime once, right
	// after this init returns.
	esl_applySdRules();

	// Make the mod download url part of the server info, otherwise a client that
	// does not have the mod fails before it even asks for anything.
	esl_publishDownloadInfo();

	// Spectators and dead players stay on their own team.  Synchronous, because
	// the game type caches this dvar while it starts up - see
	// esl_applySpectateRules().
	esl_applySpectateRules();

	// Everything else runs in a thread: if anything in there errors, the thread
	// dies and prints to the console, the game keeps running.
	level thread esl_start();

	// sd.gsc clamps scr_sd_roundswitch to 0..9 after this point, so the value has
	// to be raised again once the game type has finished starting up.
	level thread esl_patchRoundSwitch();

	// The cached copy of the spectate dvar, and the game type's own "watch the
	// enemy team" override - see esl_patchSpectatetype().
	level thread esl_patchSpectatetype();
}


// =============================================================================
//  VERSION
//
//  esl_modVersion() below is generated by tools\build.ps1 out of version.txt in the
//  repository root - that marker pair is where it goes - so the number the game
//  reports is written into the same code the build was made from and cannot
//  disagree with it.  A release is: bump version.txt, tools\install.cmd, restart.
// =============================================================================
// [esl-version:begin]
esl_modVersion()
{
	return "0.0";
}
// [esl-version:end]


// Puts the version into sv_hostname, where every client sees it: the server list is
// where a player checks which build they are joining.
//
// It is APPENDED rather than composed from a template, so whatever the config calls
// the server keeps that name and the version lands at the end of it.  The check
// makes it idempotent: sv_hostname is a server dvar that outlives a level, while
// esl_start() runs on every one - appending blindly would grow the name by a
// " v1.0" on every map change.
esl_stampHostname()
{
	// The version carries its own colour (3 = yellow): the rest of the name is the
	// config's own colouring, and a stamp in the same white as the text it follows
	// reads as part of the name rather than as the build it is.
	tag  = "v" + esl_modVersion();
	name = getDvar( "sv_hostname" );

	if ( name == "" || isSubStr( name, tag ) )
		return;

	setDvar( "sv_hostname", name + " ^3" + tag );
}


// Reads an "esl_<rule>" dvar and treats an unset dvar as enabled (the default),
// so the rules work even when no config was exec'd at all.
esl_ruleOn( ruleName )
{
	if ( getDvar( "esl_rules_enable" ) != "" && getDvarInt( "esl_rules_enable" ) == 0 )
		return false;

	if ( getDvar( ruleName ) == "" )
		return true;

	return getDvarInt( ruleName ) != 0;
}


// Threaded part of the start-up: dvar registration, monitors, banner.
esl_start()
{
	esl_registerDvars();
	esl_applyNativeDvars();

	// registers the in-game create-a-class menus (game[] keys + precache)
	esl_menuInit();

	level thread esl_onPlayerConnect();
	level thread esl_onPlayerSpawned();
	level thread esl_watchdog();
	level thread esl_keepSpectatingOwnTeam();

	// End-of-match map vote: the menu (precache + its dvars) and the thread that
	// reports whether the end-of-match hook loaded.  The vote itself is driven by
	// the game's own endGame() - see esl_mapVoteEndgame().
	esl_mapVoteInit();
	level thread esl_mapVoteWatch();

	// The version, into the server name - see esl_stampHostname()
	esl_stampHostname();

	println( "^2[ESL-MOD]^7 rule set loaded" );

	// The same line into logs\games_mp.log, where it can be read back: println
	// reaches no file on a dedicated server, which is why a session used to leave
	// no trace of the rule set it actually ran with.
	if ( level.eslLoggedBoot != true )
	{
		level.eslLoggedBoot = true;

		esl_log( "v" + esl_modVersion() + " boot " + level.gameType +
		         " winlimit=" + getDvar( "scr_sd_winlimit" ) +
		         " roundlimit=" + getDvar( "scr_sd_roundlimit" ) +
		         " roundswitch=" + getDvar( "esl_sd_roundswitch" ) +
		         " defusetime=" + getDvar( "scr_sd_defusetime" ) +
		         " spectatetype=" + getDvar( "scr_game_spectatetype" ) );

	}

	if ( getDvarInt( "esl_debug" ) )
		esl_printConfig();
}


// =============================================================================
//  CONFIGURATION
// =============================================================================

esl_registerDvars()
{
	setDvarIfUninitialized( "esl_rules_enable", 1 );
	setDvarIfUninitialized( "esl_notify", 1 );
	setDvarIfUninitialized( "esl_debug", 0 );
	setDvarIfUninitialized( "esl_sanitize_interval", 5 );

	setDvarIfUninitialized( "esl_no_killstreaks", 1 );
	setDvarIfUninitialized( "esl_no_deathstreaks", 1 );
	setDvarIfUninitialized( "esl_no_perks", 1 );

	// Optional: additionally force the death streak counter to 0.  Off by default
	// because writing self.pers while the level is loading crashes the engine;
	// esl_stripDeathstreaks() already neutralises every death streak anyway.
	setDvarIfUninitialized( "esl_deathstreak_clamp", 0 );

	setDvarIfUninitialized( "esl_enforce_attachments", 1 );
	setDvarIfUninitialized( "esl_enforce_equipment", 1 );
	setDvarIfUninitialized( "esl_enforce_weapons", 1 );

	// --- attachments ---------------------------------------------------------
	// "none" always stays selectable, the rest default to a competitive set:
	// ESL runs without silencers: the allowed set is FMJ and Extended Mags.
	// These defaults apply when the server config is not exec'd, so they match
	// the ruleset out of the box (config\ESL-MOD.cfg sets the same values).
	setDvarIfUninitialized( "esl_attach_silencer", 0 );

	setDvarIfUninitialized( "esl_attach_acog", 0 );
	setDvarIfUninitialized( "esl_attach_reflex", 0 );
	setDvarIfUninitialized( "esl_attach_eotech", 0 );
	setDvarIfUninitialized( "esl_attach_thermal", 0 );
	setDvarIfUninitialized( "esl_attach_grip", 0 );
	setDvarIfUninitialized( "esl_attach_gl", 0 );
	setDvarIfUninitialized( "esl_attach_shotgun", 0 );
	setDvarIfUninitialized( "esl_attach_heartbeat", 0 );
	setDvarIfUninitialized( "esl_attach_fmj", 1 );
	setDvarIfUninitialized( "esl_attach_rof", 0 );
	setDvarIfUninitialized( "esl_attach_xmags", 1 );
	setDvarIfUninitialized( "esl_attach_akimbo", 0 );
	setDvarIfUninitialized( "esl_attach_tactical", 0 );

	// --- lethal / equipment --------------------------------------------------
	// The lethal slot is offered in the editor as frag grenade or throwing knife.
	setDvarIfUninitialized( "esl_allow_frag_grenade", 1 );
	setDvarIfUninitialized( "esl_allow_semtex", 1 );
	setDvarIfUninitialized( "esl_allow_throwingknife", 1 );
	setDvarIfUninitialized( "esl_allow_claymore", 0 );
	setDvarIfUninitialized( "esl_allow_c4", 0 );
	setDvarIfUninitialized( "esl_allow_blastshield", 1 );
	setDvarIfUninitialized( "esl_allow_tacticalinsertion", 0 );

	// --- tactical ------------------------------------------------------------
	setDvarIfUninitialized( "esl_allow_flash_grenade", 1 );
	setDvarIfUninitialized( "esl_allow_smoke_grenade", 1 );
	setDvarIfUninitialized( "esl_allow_concussion_grenade", 1 );

	// --- weapons -------------------------------------------------------------
	// Comma separated list of BASE weapon names that are not allowed, e.g.
	//   set esl_weapon_denylist "ak74u,peacekeeper,riotshield,onemanarmy"
	// No spaces, lower case.
	setDvarIfUninitialized( "esl_weapon_denylist", "" );

	// --- spectating ----------------------------------------------------------
	// 1 = a dead player (or a spectator without a team) may only watch players
	// of their own team.  The game's own default is 2 = "free": every team plus
	// a free camera, which lets a dead player follow the enemy and watch the
	// bomb being defused.  See esl_applySpectateRules().
	setDvarIfUninitialized( "esl_spectate_team_only", 1 );

	// --- classes -------------------------------------------------------------
	// 1 = keep a player's classes across a map change.  They are archived in
	// server dvars, the only state that outlives a level - see the "class
	// archive" section in this file.  0 = the old behaviour, i.e. every map
	// starts from the type defaults and the players rebuild their classes.
	setDvarIfUninitialized( "esl_keep_classes", 1 );

	// --- Search & Destroy match format ---------------------------------------
	// ESL S&D: first to 13 round wins, 24 rounds in total so both halves are 12
	// rounds, sides switch after the 12th, 7.5 seconds to defuse.  A round limit
	// of 24 means a 12-12 match is a draw rather than a deciding round 25.  These
	// mirror the native scr_sd_* dvars; see esl_applySdRules() for how they are
	// pushed into the game type.
	setDvarIfUninitialized( "esl_sd_rules", 1 );
	setDvarIfUninitialized( "esl_sd_winlimit", 13 );
	setDvarIfUninitialized( "esl_sd_roundlimit", 24 );
	setDvarIfUninitialized( "esl_sd_roundswitch", 12 );
	setDvarIfUninitialized( "esl_sd_defusetime", 7.5 );

	// --- end-of-match map vote -----------------------------------------------
	// On by default: it replaces the engine's random rotation, so a server that
	// wants the random pick back sets esl_mapvote 0.
	//
	// esl_mapvote_delay is how long the round-end scoreboard is left alone before
	// the cards appear, esl_mapvote_time how long they then stay up.  The postgame
	// lasts as long as both together - the vote *is* the postgame, see
	// esl_mapVoteEndgame().
	setDvarIfUninitialized( "esl_mapvote", 1 );
	setDvarIfUninitialized( "esl_mapvote_delay", 3 );
	setDvarIfUninitialized( "esl_mapvote_time", 15 );
}


// Unset means enabled.
//
// This used to be getDvarInt( "esl_rules_enable" ) != 0, and that is why every
// monitor stayed silent: the server config is not exec'd on every setup, so the
// dvar did not exist, getDvarInt returned 0, and esl_enabled() was false for the
// whole match.  The menu paths do not consult it, which is why the editor kept
// working while the spawn hook, the watch dog and the durable class copy did
// nothing at all.
// Whether the diagnostic layer should speak up: the heartbeat, the state-change
// trace and the `[ESL]` lines on screen and in the console.  Off by default -
// they were built to find the round-transition bug and are distracting in play.
// `set esl_debug 1` in the console turns them all back on.
esl_debugOn()
{
	return getDvarInt( "esl_debug" ) != 0;
}


esl_enabled()
{
	value = getDvar( "esl_rules_enable" );

	if ( !isDefined( value ) || value == "" )
		return true;

	return int( value ) != 0;
}


esl_applyNativeDvars()
{
	if ( !esl_enabled() )
		return;

	// "no perks" is fully supported by the stock scripts: _perks::validatePerk()
	// replaces every perk (but keeps equipment) with specialty_null as soon as
	// scr_game_perks is 0.  The stock class menu uses the same dvar, so the perk
	// rows in create-a-class are disabled as well.
	if ( getDvarInt( "esl_no_perks" ) )
		setDvar( "scr_game_perks", 0 );

	// "no killstreaks": _gamelogic.gsc does
	//   level.killstreakRewards = getDvarInt( "scr_game_hardpoints" );
	// and _class::giveLoadout() hands out nothing when that is 0.
	if ( getDvarInt( "esl_no_killstreaks" ) )
	{
		setDvar( "scr_game_hardpoints", 0 );
		level.killstreakRewards = 0;
	}
}


// =============================================================================
//  SEARCH & DESTROY MATCH FORMAT
// =============================================================================

// Whether the S&D match format should be pushed into the game type.  Unset
// esl_sd_rules counts as on (same rule as every other esl_* switch), and the
// whole block is skipped outside S&D.
esl_sdRulesOn()
{
	if ( !esl_ruleOn( "esl_sd_rules" ) )
		return false;

	if ( toLower( getDvar( "g_gametype" ) ) != "sd" )
		return false;

	return true;
}


// Writes the native scr_sd_* dvars.
//
// This is called from esl_init(), which sd.gsc reaches from the very top of its
// own main() (_globallogic::init() -> esl_init()).  Its dvar registration and
// updateGametypeDvars() both run afterwards, so setting the values here is
// early enough for them to take effect for the whole match.  It has to be
// synchronous for defusetime in particular: that one is read exactly once, into
// level.defuseTime.
// Reads one of the esl_sd_* numbers.
//
// These are read from level init, which happens before esl_registerDvars() has
// run, so an unset dvar has to be told apart from an explicit 0 - hence the
// string check plus a caller supplied fallback.
esl_sdNumber( dvarName, fallback )
{
	if ( getDvar( dvarName ) == "" )
		return fallback;

	return getDvarFloat( dvarName );
}


esl_applySdRules()
{
	if ( !esl_sdRulesOn() )
		return;

	// first to 13 round wins, 24 rounds in total, sides switch after 12,
	// 7.5 seconds to defuse.
	winLimit = int( esl_sdNumber( "esl_sd_winlimit", 13 ) );
	if ( winLimit < 1 )
		winLimit = 13;

	// 0 = no round limit at all; negative means "unset" and falls back to 24.
	roundLimit = int( esl_sdNumber( "esl_sd_roundlimit", 24 ) );
	if ( roundLimit < 0 )
		roundLimit = 24;

	roundSwitch = int( esl_sdNumber( "esl_sd_roundswitch", 12 ) );
	if ( roundSwitch < 1 )
		roundSwitch = 12;

	defuseTime = esl_sdNumber( "esl_sd_defusetime", 7.5 );
	if ( defuseTime <= 0 )
		defuseTime = 7.5;

	setDvar( "scr_sd_winlimit", winLimit );
	setDvar( "scr_sd_roundlimit", roundLimit );
	setDvar( "scr_sd_roundswitch", roundSwitch );
	setDvar( "scr_sd_defusetime", defuseTime );
}


// Publishes the IW4x mod-download dvars to clients.
//
// IW4x can hand the mod to a client that does not have it: the client asks the
// server for the mod list and fetches the files from `sv_wwwBaseUrl` over plain
// HTTP (see docs\SERVER.md).  It can only do that if it knows the url, and it
// learns it from the server info string - if the engine does not put these dvars
// there, the client gives up immediately with "Failed to download the mod list"
// without sending a single request anywhere, which is exactly what a bare
// `set sv_wwwBaseUrl ...` in a config produces.
//
// Both calls are plain dvar operations, so they are safe in level init.
esl_publishDownloadInfo()
{
	if ( getDvar( "sv_wwwBaseUrl" ) != "" )
		makeDvarServerInfo( "sv_wwwBaseUrl", getDvar( "sv_wwwBaseUrl" ) );

	if ( getDvar( "sv_wwwDownload" ) != "" )
		makeDvarServerInfo( "sv_wwwDownload", getDvarInt( "sv_wwwDownload" ) );
}


// Undoes the stock round switch clamp.
//
// sd.gsc registers it as registerRoundSwitchDvar( level.gameType, 3, 0, 9 ), and
// that helper in _utility.gsc clamps the dvar and stores the *clamped* value in
// level.roundswitch.  All of that happens after esl_init(), so the halftime
// would silently move to round 9 (and the display would read "intermission",
// because the round limit path compares roundsPlayed * 2 against the round
// limit).  checkRoundSwitch() reads the field only when a round ends, so
// raising it again one second after level start is safe - round 12 is minutes
// away, and a side switch at round 9 is what this prevents.
esl_patchRoundSwitch()
{
	if ( !esl_sdRulesOn() )
		return;

	roundSwitch = int( esl_sdNumber( "esl_sd_roundswitch", 12 ) );
	if ( roundSwitch < 1 )
		return;

	// let sd.gsc::main() finish registering its own dvars first
	wait 1.0;

	level.roundswitch = roundSwitch;

	if ( esl_debugOn() )
		println( "  [ESL] sides switch every " + roundSwitch + " rounds" );
}


// =============================================================================
//  SPECTATING
// =============================================================================

// Keeps dead players and spectators on their own team.
//
// scr_game_spectatetype defaults to 2 ("free"): every team plus a free camera,
// so a dead player can cycle through the enemy - and in S&D that means watching
// the surviving defenders defuse a planted bomb.  ESL sets 1, which
// _spectating.gsc::setSpectatePermissions() implements as "own team only".
//
// The dvar on its own is not enough.  _tweakables::registerTweakable() caches
// the value in level.gameTweaks["spectatetype"].value while the level is
// starting, and setSpectatePermissions() reads that cached copy, not the dvar -
// so whichever of the two is written first, the other one is covered by
// esl_patchSpectatetype().
esl_applySpectateRules()
{
	if ( !esl_ruleOn( "esl_spectate_team_only" ) )
		return;

	setDvar( "scr_game_spectatetype", 1 );
}


// Raises the cached copy of scr_game_spectatetype once the game type has
// finished registering its tweakables, and re-applies the permissions.
// See esl_applySpectateRules().
esl_patchSpectatetype()
{
	if ( !esl_ruleOn( "esl_spectate_team_only" ) )
		return;

	// let _tweakables::init() (reached through the game type's own init) finish
	wait 1.0;

	setDvar( "scr_game_spectatetype", 1 );

	if ( !isDefined( level.gameTweaks ) )
		return;

	if ( !isDefined( level.gameTweaks["spectatetype"] ) )
		return;

	level.gameTweaks["spectatetype"].value = 1;

	// On its own thread: updateSpectateSettings() ends on "game_ended", and that
	// must not take the caller with it (the poller below runs for the whole map).
	level thread maps\mp\gametypes\_spectating::updateSpectateSettings();

	if ( esl_debugOn() )
		println( "  [ESL] spectators are limited to their own team" );
}


// Whether the game type has opened the other team up for one of the two teams.
//
// sd.gsc::checkAllowSpectating() sets level.spectateOverride[team]
// .allowEnemySpectate as soon as that entire team is dead - the stock "watch
// the other side while you wait" rule - and nothing ever clears it again, so
// from the first team wipe on, that team could watch the enemy for the rest of
// the map.
esl_enemySpectateOpen()
{
	if ( !isDefined( level.spectateOverride ) )
		return false;

	allies = level.spectateOverride["allies"];
	axis   = level.spectateOverride["axis"];

	if ( !isDefined( allies ) || !isDefined( axis ) )
		return false;

	return isDefined( allies.allowEnemySpectate ) || isDefined( axis.allowEnemySpectate );
}


// Closes the other team again, as soon as the game type opens it.
//
// level.spectateOverride holds nothing but those two flags, so replacing the
// structs is the way to remove them (GSC has no member delete), and
// updateSpectateSettings() then pushes the permissions to every player again.
// The poll interval is what bounds the window in which the enemy is viewable.
esl_keepSpectatingOwnTeam()
{
	if ( !esl_ruleOn( "esl_spectate_team_only" ) )
		return;

	for ( ;; )
	{
		if ( esl_enemySpectateOpen() )
		{
			level.spectateOverride["allies"] = spawnStruct();
			level.spectateOverride["axis"]   = spawnStruct();

			level thread maps\mp\gametypes\_spectating::updateSpectateSettings();

			if ( esl_debugOn() )
				println( "  [ESL] the enemy team is closed again for spectators" );
		}

		wait 0.1;
	}
}


esl_printConfig()
{
	println( "  ESL-MOD config:" );
	println( "    rules_enable        = " + getDvar( "esl_rules_enable" ) );
	println( "    no_killstreaks      = " + getDvar( "esl_no_killstreaks" ) );
	println( "    no_deathstreaks     = " + getDvar( "esl_no_deathstreaks" ) );
	println( "    no_perks            = " + getDvar( "esl_no_perks" ) );
	println( "    enforce_attachments = " + getDvar( "esl_enforce_attachments" ) );
	println( "    enforce_equipment   = " + getDvar( "esl_enforce_equipment" ) );
	println( "    enforce_weapons     = " + getDvar( "esl_enforce_weapons" ) );
	println( "    weapon_denylist     = " + getDvar( "esl_weapon_denylist" ) );
	println( "    sanitize_interval   = " + getDvar( "esl_sanitize_interval" ) );
	println( "    allow_frag          = " + getDvar( "esl_allow_frag_grenade" ) );
	println( "    allow_semtex        = " + getDvar( "esl_allow_semtex" ) );
	println( "    allow_throwingknife = " + getDvar( "esl_allow_throwingknife" ) );
	println( "    attach_fmj          = " + getDvar( "esl_attach_fmj" ) );
	println( "    attach_xmags        = " + getDvar( "esl_attach_xmags" ) );
	println( "    attach_silencer     = " + getDvar( "esl_attach_silencer" ) );
	println( "    sd_rules            = " + getDvar( "esl_sd_rules" ) );
	println( "    sd_winlimit         = " + getDvar( "esl_sd_winlimit" ) );
	println( "    sd_roundlimit       = " + getDvar( "esl_sd_roundlimit" ) );
	println( "    sd_roundswitch      = " + getDvar( "esl_sd_roundswitch" ) );
	println( "    sd_defusetime       = " + getDvar( "esl_sd_defusetime" ) );
	println( "    spectate_team_only  = " + getDvar( "esl_spectate_team_only" ) );
	println( "    keep_classes        = " + getDvar( "esl_keep_classes" ) );
}


// =============================================================================
//  PLAYER MONITORS
// =============================================================================

esl_onPlayerConnect()
{
	for ( ;; )
	{
		level waittill( "connected", player );

		player thread esl_playerInit();
	}
}


esl_playerInit()
{
	// NOTE: the stored classes are deliberately NOT touched here.
	//
	// This runs on "connected", i.e. while the level is still loading.  Writing
	// player state at that moment (self.pers in particular) has been observed to
	// hang the loading screen - and on one run to crash the engine outright with
	// an access violation (0xC0000005).  The first sanitiser pass therefore
	// happens on the first spawn instead, see esl_spawnEnforcer().
	esl_attachPlayerLogic();

	// Reads and a log line only, so it is safe at this point - and it is the one
	// place that records which key this player's classes are stored under.  Two
	// players with the same key share their class storage; nothing else in the
	// game, and no other log, ever prints it.
	guid = self getGuid();
	xuid = self getXuid();

	esl_log( "join " + self.name + " id=" + esl_storeId() + " guid=" + guid + " xuid=" + xuid );
}


// Starts the per-player monitors, once per entity.
//
// Everything here used to be started from the "connected" notify, which only
// ever fires for the first entity of a client.  A round transition can hand the
// player a fresh entity - and then the monitors were simply gone: the first
// spawn still announced itself, and every later one did nothing, which is
// exactly what "no readings after respawning" was, and why the class could not
// be kept.  esl_onPlayerSpawned() re-arms them from the level side, where the
// thread is not attached to a player entity at all.
esl_attachPlayerLogic()
{
	if ( !esl_enabled() )
		return;

	if ( isDefined( self.eslHooked ) )
		return;

	self.eslHooked = true;

	self thread esl_deathstreakGuardOnDeath();
	self thread esl_deathstreakGuardOnSpawn();
	self thread esl_spawnEnforcer();
}


esl_onPlayerSpawned()
{
	level endon( "game_ended" );

	for ( ;; )
	{
		level waittill( "player_spawned", player );

		if ( !isDefined( player ) )
			continue;

		// Seed first, and *here*: the engine calls giveLoadout() a few lines later
		// in the same frame, so this is the last moment at which the working copy
		// can be filled from the playerdata.  On the first spawn of a new level the
		// level store is empty and only the playerdata copy has the class - seeding
		// any later left that spawn with the type defaults, i.e. no camo and no
		// tactical, which is exactly what the first round after a level change
		// looked like.
		player esl_seedStorage();

		player esl_attachPlayerLogic();
	}
}


esl_seedStorage()
{
	if ( !esl_enabled() )
		return;

	// A spawn consumes a deferred class change: from here the weapons in hand are
	// expected to match the class again.
	self.eslPendingClass = undefined;

	// The loadout repair in esl_enforceClass() is only allowed for a moment after
	// a spawn - see the comment there.  It is armed here because this runs on
	// every spawn, before the engine builds the loadout.
	self.eslLoadoutGraceUntil = getTime() + 3000;
	self.eslPickupLogged       = undefined;

	esl_restoreActiveClass();
}


// The channel that can actually be read back from outside the game.
//
// println reaches no file on this setup, iprintln only the client console (which
// is not captured either) and the player config does not archive our dvars.  The
// engine's own log facility does: logString() appends to the mod's
// logs\games_mp.log, the same file that carries the engine's Weapon/K event
// lines.  It is an engine builtin - no script defines it - used the same way by
// the stock gametype scripts and by ProMod, so it resolves from this file too.
esl_log( text )
{
	// logPrint, not logString.  logString turned out to write nowhere on this
	// setup - a whole session's worth of commit/enforceClass lines was missing
	// from logs\games_mp.log - while the engine's own D;/K;/Weapon; lines, which
	// are written with logPrint(), are all there.  Since this is the only channel
	// that can be read back after a match, the diagnostics have to use it.
	logPrint( "ESL-MOD " + text + "\n" );
}


// One line per spawn.  Between them these values
// say exactly what a round transition took away, which is the only way to tell
// the three cases apart from the outside:
//   pers.class / self.class disagree          -> the game re-chose the class
//   type=-                                    -> the ESL type memory was lost
//   type set, loadout=NO-STORAGE              -> the stored class was lost
//   type set, loadout has a different weapon  -> the storage was rewritten
//
// It deliberately reads self.eslClasses[...] directly instead of going through
// esl_cacWeapon() - that accessor would (re)create the class with its defaults
// and hide the very loss we are looking for.
esl_logSpawnState( label )
{
	persCls = "undefined";
	if ( isDefined( self.pers["class"] ) )
		persCls = self.pers["class"];

	selfCls = "undefined";
	if ( isDefined( self.class ) )
		selfCls = self.class;

	type = "-";

	if ( isDefined( self.eslClassType ) )
		type = self.eslClassType;

	loadout = "-";

	if ( type != "-" )
	{
		slot = esl_classTypeSlot( type );

		if ( isDefined( self.eslClasses ) && isDefined( self.eslClasses[slot] ) )
			loadout = self.eslClasses[slot]["weapon0"] + "/" + self.eslClasses[slot]["weapon1"] + "/" + self.eslClasses[slot]["perk0"];
		else
			loadout = "NO-STORAGE";
	}

	line = label + ": cls=" + persCls + " self=" + selfCls + " type=" + type + " wpn=" + loadout;

	// Both channels, on purpose.  println() is the server print: on this setup it
	// never showed up in userraw\console_mp.log *or* in the mod's own
	// logs\games_mp.log (which only carries the game's own J/K/Weapon events), so
	// it cannot be relied on to see anything.  iprintln() goes to the client
	// console and the chat, which is the one place the player can actually read
	// back - and the only one left when a round transition has to be explained.
	if ( !esl_debugOn() )
		return;

	println( "ESL-MOD [" + line + "]" );
	self iprintln( "^2[ESL]^7 " + line );
	esl_log( line );

	// On screen, because the console is not readable on this setup: the client
	// console log only captures engine messages, and println reaches no file at
	// all.  This is how a round transition can be observed directly.
	if ( label == "spawn" )
		self iPrintLnBold( "^3[ESL]^7 spawn: " + type + " / " + loadout );
}


// Fires for every spawn.  In Search & Destroy that is exactly once per round,
// in respawn game types it runs every life.
esl_spawnEnforcer()
{
	self endon( "disconnect" );

	for ( ;; )
	{
		self waittill( "spawned_player" );

		// Reported before the enable check on purpose: this line appearing or not
		// is what tells the two failure modes apart - "the hook is not running"
		// versus "the hook runs but is gated out".
		esl_logSpawnState( "spawn" );

		if ( !esl_enabled() )
			continue;

		// The entity may have come back from a round transition without the ESL
		// fields; rebuild them from the playerdata copy before anything else
		// looks at the class.
		if ( self esl_restoreActiveClass() )
		{
			self iprintln( "^2[ESL]^7 class memory restored" );
			esl_log( "restore: memory rebuilt from the durable copy" );
		}

		if ( getDvarInt( "esl_no_deathstreaks" ) )
			self thread esl_stripDeathstreaks();

		// Re-sanitise the stored classes.  If anything the player can actually
		// carry was changed, rebuild the loadout on the spot so the change takes
		// effect immediately instead of next round.
		if ( self esl_sanitizeStoredClasses() )
			self thread esl_reapplyLoadout();

		// Keep the ESL class across round transitions.  The loadout for this
		// spawn has already been built by the time we get here, so when the class
		// had to be corrected, rebuild it now - otherwise the player stays on a
		// default class until the next round, which reads as "my class reset".
		if ( esl_keepClass() )
			self thread esl_reapplyLoadout();

		esl_logSpawnState( "spawn-done" );
	}
}


// Re-asserts the player's ESL class as the class the *next* spawn will build.
//
// In round based game types the class selection is re-run between rounds and
// pers["class"] ends up back on a vanilla class, which silently resets the
// player to a stock loadout at the following spawn.  This runs on
// spawned_player and never during level load - writing player state while the
// level loads is the one thing that destabilises the engine, see
// docs/DIAGNOSTICS.md.
esl_keepClass()
{
	// the durable copy, not the entity field: right after a round transition the
	// field is exactly what is missing
	type = esl_memoryType();

	if ( type == "" )
		return false;

	name = esl_classTypeName( type );

	if ( name == "" )
		return false;

	if ( isDefined( self.pers["class"] ) && self.pers["class"] == name )
		return false;

	// Plain println, not iprintln: this goes to userraw\console_mp.log whether or
	// not esl_notify is set, which is how we see round transitions at all.
	dropped = "undefined";
	if ( isDefined( self.pers["class"] ) )
		dropped = self.pers["class"];

	println( "ESL-MOD: spawn class was '" + dropped + "', restored to " + name );
	self iprintln( "^2[ESL]^7 spawn class was ^3" + dropped + "^7, restored to ^3" + name );
	esl_log( "keepClass: was " + dropped + " -> " + name );

	self.pers["class"] = name;
	self.class = name;

	// true = the game had dropped our class, so the caller should rebuild the
	// loadout for the life the player is in right now
	return true;
}


// Re-applies the (now sanitised) class.  _class::giveLoadout() takes care of
// removing the old weapons, so this is exactly what happens when a player
// picks a different class in the normal game flow.
esl_reapplyLoadout()
{
	self endon( "disconnect" );

	wait 0.05;

	// A rebuild takes every weapon away for a moment, so it must never happen
	// while a plant or a defuse is running - that cancels it.
	if ( ( isDefined( self.isPlanting ) && self.isPlanting ) || ( isDefined( self.isDefusing ) && self.isDefusing ) )
		return;

	if ( !isDefined( self.pers["team"] ) )
		return;

	if ( self.pers["team"] != "allies" && self.pers["team"] != "axis" )
		return;

	if ( !isDefined( self.pers["class"] ) || self.pers["class"] == "" )
		return;

	// Deliberately not "isDefined( level.classMap[...] )": the engine rebuilds that
	// variable without our entries, and this check then turned every repair - the
	// spawn rebuild and the watchdog's - into a silent no-op.
	if ( esl_indexForClassName( self.pers["class"] ) < 0 && !isDefined( level.classMap[ self.pers["class"] ] ) )
		return;

	// _playerlogic::spawnPlayer() hands giveLoadout() *self.class*, not
	// pers["class"], so the two must agree at the moment the spawn builds the
	// loadout.  They can drift apart between rounds, and then the spawn builds a
	// stock class while pers["class"] still looks correct - which is precisely
	// what "my class reset after the round ended" looks like from the outside.
	self.class = self.pers["class"];

	println( "ESL-MOD: rebuilding loadout from " + self.pers["class"] );
	self iprintln( "^2[ESL]^7 rebuilding loadout from ^3" + self.pers["class"] );
	esl_log( "reapplyLoadout: " + self.pers["class"] );

	self maps\mp\gametypes\_class::giveLoadout( self.pers["team"], self.pers["class"], false );

	if ( getDvarInt( "esl_notify" ) )
		self iprintln( "^2[ESL-MOD]^7 your class was adjusted to the ESL rule set" );
}


// Death streaks are neutralised by esl_stripDeathstreaks() alone (perk API only,
// no player state writes).  The optional counter clamp below is opt-in
// (esl_deathstreak_clamp 1) and is strictly event driven.
//
// IMPORTANT: both guards wait for the first spawn before doing anything at all.
// Touching self.pers while the level is loading crashed the engine with an
// access violation, so no player state is written until the level is running.
esl_deathstreakGuardOnSpawn()
{
	self endon( "disconnect" );

	self waittill( "spawned_player" );

	if ( !esl_clampEnabled() )
		return;

	for ( ;; )
	{
		esl_clampDeathstreak();

		self waittill( "spawned_player" );
	}
}


esl_deathstreakGuardOnDeath()
{
	self endon( "disconnect" );
	self endon( "death" );

	self waittill( "spawned_player" );

	if ( !esl_clampEnabled() )
		return;

	for ( ;; )
	{
		esl_clampDeathstreak();

		self waittill( "death" );
	}
}


esl_clampEnabled()
{
	if ( !esl_enabled() )
		return false;

	if ( !getDvarInt( "esl_no_deathstreaks" ) )
		return false;

	return getDvarInt( "esl_deathstreak_clamp" ) != 0;
}


esl_clampDeathstreak()
{
	// Reading an undefined pers field is safe; writing one is not, so only write
	// when the field is known to exist.
	if ( !isDefined( self.pers["cur_death_streak"] ) )
		return;

	if ( self.pers["cur_death_streak"] != 0 )
		self.pers["cur_death_streak"] = 0;
}


// All perk4 entries of mp/perktable.csv, plus the perks those hand out.
esl_stripDeathstreaks()
{
	self endon( "disconnect" );

	wait 0.25;

	if ( self _hasPerk( "specialty_grenadepulldeath" ) )
		self _unsetPerk( "specialty_grenadepulldeath" );

	if ( self _hasPerk( "specialty_c4death" ) )
		self _unsetPerk( "specialty_c4death" );

	if ( self _hasPerk( "specialty_copycat" ) )
		self _unsetPerk( "specialty_copycat" );

	if ( self _hasPerk( "specialty_finalstand" ) )
	{
		self _unsetPerk( "specialty_finalstand" );
		self maps\mp\perks\_perkfunctions::unsetFinalStand();
	}

	if ( self _hasPerk( "specialty_combathigh" ) )
	{
		self _unsetPerk( "specialty_combathigh" );
		self maps\mp\perks\_perkfunctions::unsetCombatHigh();
	}

	// Perks a death streak can leave behind.
	if ( self _hasPerk( "specialty_pistoldeath" ) )
		self _unsetPerk( "specialty_pistoldeath" );

	if ( self _hasPerk( "specialty_laststandoffhand" ) )
		self _unsetPerk( "specialty_laststandoffhand" );
}


// =============================================================================
//  STORED CLASS SANITISER
//
//  Rewrites the player's saved custom classes so that the create-a-class menu
//  (and every following spawn) only ever sees legal values.  Returns true when
//  something that affects the actual loadout was changed.
// =============================================================================

esl_sanitizeStoredClasses()
{
	changed = false;

	checkWeapons   = getDvarInt( "esl_enforce_weapons" ) != 0;
	checkAttach    = getDvarInt( "esl_enforce_attachments" ) != 0;
	checkEquipment = getDvarInt( "esl_enforce_equipment" ) != 0;
	clearPerks     = getDvarInt( "esl_no_perks" ) != 0;
	clearDeath     = getDvarInt( "esl_no_deathstreaks" ) != 0;
	clearStreaks   = getDvarInt( "esl_no_killstreaks" ) != 0;

	if ( !checkWeapons && !checkAttach && !checkEquipment && !clearPerks && !clearDeath && !clearStreaks )
		return false;

	// Which stored class the player is actually playing with.  Only a change to
	// that one justifies rebuilding the loadout and telling the player their
	// class was adjusted; cleaning the classes they are not using is still done
	// (it keeps the vanilla create-a-class legal) but must stay silent.
	currentIndex = -1;

	if ( isDefined( self.pers["class"] ) )
	{
		currentIndex = esl_indexForClassName( self.pers["class"] );

		if ( currentIndex < 0 && isDefined( level.classMap[ self.pers["class"] ] ) )
			currentIndex = level.classMap[ self.pers["class"] ];
	}

	// ---- stored classes: the 15 vanilla slots plus the three ESL ones -------
	// The ESL classes use the indices 15/16/17 and the patched _class.gsc
	// accessors read and write their own storage for those, so the same loop
	// covers them - a rule change mid-match is therefore enforced on the ESL
	// classes as well.
	for ( classIndex = 0; classIndex < 18; classIndex++ )
	{
		for ( weaponIndex = 0; weaponIndex < 2; weaponIndex++ )
		{
			weapon = self maps\mp\gametypes\_class::cac_getWeapon( classIndex, weaponIndex );

			if ( !isDefined( weapon ) || weapon == "" || weapon == "none" )
				continue;

			if ( checkWeapons && esl_weaponBanned( weapon ) )
			{
				// Leave the slot empty rather than picking a substitute, the
				// player has to choose a legal weapon before spawning again.
				esl_setStoredWeapon( classIndex, weaponIndex, "none" );

				if ( classIndex == currentIndex )
				{
					changed = true;
					println( "ESL-MOD: class " + classIndex + " slot " + weaponIndex + " weapon '" + weapon + "' is not allowed - cleared" );
				}

				continue;
			}

			if ( !checkAttach )
				continue;

			for ( attachmentIndex = 0; attachmentIndex < 2; attachmentIndex++ )
			{
				attachment = esl_getStoredAttachment( classIndex, weaponIndex, attachmentIndex );

				if ( !isDefined( attachment ) || attachment == "" || attachment == "none" )
					continue;

				if ( !esl_attachmentAllowed( attachment ) )
				{
					esl_setStoredAttachment( classIndex, weaponIndex, attachmentIndex, "none" );

					if ( classIndex == currentIndex )
					{
						changed = true;
						println( "ESL-MOD: class " + classIndex + " attachment '" + attachment + "' is not allowed - cleared" );
					}
				}
			}
		}

		// ---- equipment, perks and the death streak slot --------------------
		if ( checkEquipment || clearPerks || clearDeath )
		{
			for ( perkIndex = 0; perkIndex < 5; perkIndex++ )
			{
				perk = self maps\mp\gametypes\_class::cac_getPerk( classIndex, perkIndex );

				if ( !isDefined( perk ) || perk == "" )
					continue;

				// slot 0 is equipment, slot 4 is the death streak, 1-3 are perks
				if ( perkIndex == 4 )
				{
					if ( clearDeath && perk != "specialty_null" )
						esl_setStoredPerk( classIndex, perkIndex, "specialty_null" );

					continue;
				}

				if ( perkIndex == 0 )
				{
					if ( checkEquipment && !esl_equipmentAllowed( perk ) )
					{
						esl_setStoredPerk( classIndex, perkIndex, esl_defaultEquipment() );

						if ( classIndex == currentIndex )
						{
							changed = true;
							println( "ESL-MOD: class " + classIndex + " equipment '" + perk + "' is not allowed - reset to " + esl_defaultEquipment() );
						}
					}

					continue;
				}

				if ( clearPerks && perk != "specialty_null" )
				{
					esl_setStoredPerk( classIndex, perkIndex, "specialty_null" );

					if ( classIndex == currentIndex )
					{
						changed = true;
						println( "ESL-MOD: class " + classIndex + " perk" + perkIndex + " '" + perk + "' removed" );
					}
				}
			}
		}

		// ---- tactical equipment slot ---------------------------------------
		if ( checkEquipment )
		{
			offhand = self maps\mp\gametypes\_class::cac_getOffhand( classIndex );

			if ( isDefined( offhand ) && offhand != "" && offhand != "none" && !esl_offhandAllowed( offhand ) )
			{
				esl_setStoredOffhand( classIndex, esl_defaultOffhand() );

				if ( classIndex == currentIndex )
				{
					changed = true;
					println( "ESL-MOD: class " + classIndex + " tactical '" + offhand + "' is not allowed - reset to " + esl_defaultOffhand() );
				}
			}
		}
	}

	// ---- killstreaks --------------------------------------------------------
	if ( clearStreaks )
	{
		for ( streakIndex = 0; streakIndex < 3; streakIndex++ )
		{
			streak = self getPlayerData( "killstreaks", streakIndex );

			if ( isDefined( streak ) && streak != "none" )
				self setPlayerData( "killstreaks", streakIndex, "none" );
		}
	}

	return changed;
}


// --- stored class accessors --------------------------------------------------

esl_getStoredAttachment( classIndex, weaponIndex, attachmentIndex )
{
	if ( attachmentIndex == 0 )
		return self maps\mp\gametypes\_class::cac_getWeaponAttachment( classIndex, weaponIndex );

	return self maps\mp\gametypes\_class::cac_getWeaponAttachmentTwo( classIndex, weaponIndex );
}


// -----------------------------------------------------------------------------
//  ESL class storage
//
//  The three ESL class types own their loadouts outright.  They are kept in
//  script data on the player - self.eslClasses[classIndex] - and the vanilla
//  custom-class playerdata is never read or written for them, so nothing the
//  player built in the main-menu create-a-class can leak in, and the ESL editor
//  cannot modify the vanilla classes either.
//
//  Two things make the stock _class::giveLoadout() cooperate:
//
//    * the class names contain "custom" ("custom_esl_assault"), which is the
//      substring giveLoadout() tests to choose its custom-class branch, and
//    * the generated _class.gsc redirects that branch's seven cac_get*()
//      accessors to the esl_cac*() functions below.
//
//  Class indices 0-14 belong to the vanilla classes, so the ESL types use
//  15/16/17 - see esl_classTypeSlot().  The loadouts are per-session by design:
//  they are not written anywhere, so they reset when the match ends.
// -----------------------------------------------------------------------------

// Asked by the patched _class.gsc before every playerdata read.
esl_isCacClass( classIndex )
{
	if ( !isDefined( classIndex ) )
		return false;

	return classIndex >= 15 && classIndex <= 17;
}


// Makes sure the storage of one class type exists, and seeds it with the ESL
// defaults the first time it is used.
//
// NOTE: every access below goes through the full self.eslClasses[...] path.  A
// local alias ("cls = self.eslClasses[x]") does not reliably write back, and a
// lost write shows up as _class::giveLoadout()'s "invalid primary" fallback -
// which is the stock M4, i.e. a class that looks like the default one.
esl_cacPrepare( classIndex )
{
	if ( !isDefined( self.eslClasses ) )
		self.eslClasses = [];

	if ( isDefined( self.eslClasses[classIndex] ) )
		return;

	self.eslClasses[classIndex] = [];

	// A copy from an earlier round wins over the defaults - this is what makes the
	// first access after a round transition see the class the player chose
	// instead of the type default.
	seeded = false;
	keys   = esl_mirrorKeys();

	for ( i = 0; i < keys.size; i++ )
	{
		stored = esl_storeGet( classIndex, keys[i] );

		// The playerdata copy outlived the level in practice - it is where the
		// committed type comes from after a level change - while level.eslStore goes
		// with the level.  It is therefore the second source, and it is what makes
		// the loadout survive as well as the type.
		if ( !isDefined( stored ) && isDefined( self.pers[ esl_persKey( classIndex, keys[i] ) ] ) )
			stored = self.pers[ esl_persKey( classIndex, keys[i] ) ];

		if ( !isDefined( stored ) )
			continue;

		self.eslClasses[classIndex][keys[i]] = stored;
		seeded = true;
	}

	if ( seeded )
		return;

	// Neither the level store nor the playerdata had anything - a fresh level, so
	// this is the map change case, and the archive dvar is what the player built
	// on the previous map.  Without it every map began with the type defaults.
	if ( esl_archiveRead( esl_slotType( classIndex ), classIndex ) )
		return;

	primary   = "m4";
	secondary = "usp";

	if ( classIndex == esl_classTypeSlot( "specops" ) )
		primary = "mp5k";
	else if ( classIndex == esl_classTypeSlot( "sniper" ) )
		primary = "cheytac";   // the Intervention - the M40A3 is not offered

	self.eslClasses[classIndex]["weapon0"] = primary;
	self.eslClasses[classIndex]["weapon1"] = secondary;

	self.eslClasses[classIndex]["attachment0_0"] = "none";
	self.eslClasses[classIndex]["attachment0_1"] = "none";
	self.eslClasses[classIndex]["attachment1_0"] = "none";
	self.eslClasses[classIndex]["attachment1_1"] = "none";

	self.eslClasses[classIndex]["camo0"] = "none";
	self.eslClasses[classIndex]["camo1"] = "none";

	// slot 0 is the equipment, 1-3 are the perks, 4 is the deathstreak
	self.eslClasses[classIndex]["perk0"] = esl_defaultEquipment();
	self.eslClasses[classIndex]["perk1"] = "specialty_null";
	self.eslClasses[classIndex]["perk2"] = "specialty_null";
	self.eslClasses[classIndex]["perk3"] = "specialty_null";
	self.eslClasses[classIndex]["perk4"] = "specialty_null";

	self.eslClasses[classIndex]["offhand"] = esl_defaultOffhand();

	// remember the defaults, so this round's choices start from them next round
	esl_mirrorClass( classIndex );
}


// -----------------------------------------------------------------------------
//  The durable class copy
//
//  self.eslClassType and self.eslClasses are script fields on the player entity,
//  so they live exactly as long as the entity does.  A round transition brought
//  the class back as the *type default* - a UMP45 and a gold Deagle turned into
//  an MP5K and a USP, the specops defaults - so the working copy cannot be the
//  only one.
//
//  Playerdata keys the engine does not know about did not survive a round
//  either, so the copy lives on the level keyed by clientid, which outlives
//  rounds inside the map.  playerdata is written as well: it costs nothing and it
//  is the one thing the engine itself carries across rounds.
//
//  The level copy is authoritative: esl_cacPrepare() seeds a missing working copy
//  from it rather than from the defaults, so the first access after a round
//  transition already sees the class the player chose.
// -----------------------------------------------------------------------------

esl_mirrorKeys()
{
	keys = [];

	keys[0]  = "weapon0";       keys[1]  = "weapon1";
	keys[2]  = "attachment0_0"; keys[3]  = "attachment0_1";
	keys[4]  = "attachment1_0"; keys[5]  = "attachment1_1";
	keys[6]  = "camo0";         keys[7]  = "camo1";
	keys[8]  = "perk0";         keys[9]  = "perk1";
	keys[10] = "perk2";         keys[11] = "perk3";
	keys[12] = "perk4";         keys[13] = "offhand";

	return keys;
}


// The key of the durable copy.
//
// clientid is not good enough: the engine re-registers a client (the client
// number in the J event differs between sessions) and a recreated entity starts
// without the field.  The XUID is a string that is stable for the whole session;
// the player name and the guid are fallbacks.
esl_storeId()
{
	if ( isDefined( self.eslStoreId ) && self.eslStoreId != "" )
		return self.eslStoreId;

	// The guid comes first: it is the value the engine itself logs per client
	// ("J;<guid>;<clientnum>;<name>"), so it is per player.  getXuid() is not
	// guaranteed to differ between clients on this build - and two players who
	// share this key share level.eslType and level.eslStore, which is how one
	// player's committed class can end up being handed to the others.
	id = self getGuid();

	if ( !isDefined( id ) || id == "" )
		id = self getXuid();

	if ( !isDefined( id ) || id == "" )
		id = self.name;

	if ( !isDefined( id ) )
		id = "";

	// Belt and braces, and the reason this is safe whatever the identifiers do:
	// two players who are online at the same time must never share the key.  The
	// entity number is unique among them, so the second user of an id gets a
	// suffix.  esl_playerInit() logs the key each player ended up with.
	if ( id != "" )
	{
		for ( index = 0; index < level.players.size; index++ )
		{
			player = level.players[index];

			if ( player == self )
				continue;

			if ( isDefined( player.eslStoreId ) && player.eslStoreId == id )
			{
				id = id + "#" + self getEntityNumber();
				break;
			}
		}
	}

	self.eslStoreId = id;

	return id;
}


esl_storeSet( slot, field, value )
{
	id = esl_storeId();

	if ( !isDefined( id ) || id == "" )
		return;

	if ( !isDefined( level.eslStore ) )
		level.eslStore = [];

	if ( !isDefined( level.eslStore[ id ] ) )
		level.eslStore[ id ] = [];

	if ( !isDefined( level.eslStore[ id ][ slot ] ) )
		level.eslStore[ id ][ slot ] = [];

	level.eslStore[ id ][ slot ][ field ] = value;
}


esl_storeGet( slot, field )
{
	id = esl_storeId();

	if ( !isDefined( id ) || id == "" )
		return;

	if ( !isDefined( level.eslStore ) )
		return;

	if ( !isDefined( level.eslStore[ id ] ) )
		return;

	if ( !isDefined( level.eslStore[ id ][ slot ] ) )
		return;

	return level.eslStore[ id ][ slot ][ field ];
}


esl_storeTypeSet( type )
{
	id = esl_storeId();

	if ( !isDefined( id ) || id == "" )
		return;

	if ( !isDefined( level.eslType ) )
		level.eslType = [];

	level.eslType[ id ] = type;
}


esl_storeTypeGet()
{
	id = esl_storeId();

	if ( !isDefined( id ) || id == "" )
		return "";

	if ( !isDefined( level.eslType ) )
		return "";

	if ( !isDefined( level.eslType[ id ] ) )
		return "";

	return level.eslType[ id ];
}


// -----------------------------------------------------------------------------
//  The class archive (what makes a class survive a map change)
//
//  Everything above is per level: self.eslClasses lives on the entity,
//  level.eslStore / level.eslType live on the level, and the playerdata mirror
//  did not outlive a map change in practice either.  A new map therefore started
//  with the type defaults - an M4 for assault - and every player had to rebuild
//  their class, which is what the first round of every map was spent on.
//
//  Server dvars are the one piece of state that does outlive a level, so the
//  accepted class is packed into one dvar per class type, plus one dvar for the
//  committed type:
//
//      esl_class_<id>_assault = "ump45|none|none|usp|none|none|none|none|..."
//      esl_type_<id>          = "specops"
//
//  The fields are in esl_mirrorKeys() order, joined with "|" - no value the
//  editor can produce contains one.  A dvar without exactly the expected number
//  of fields is ignored rather than half-applied.
//
//  The id here is deliberately NOT esl_storeId(): that one carries an
//  "#<entitynumber>" suffix for the second player to join, which would change
//  from map to map.  This is the stable per-user identifier, reduced to the
//  characters a dvar name may contain.  Turn the whole thing off with
//  `set esl_keep_classes 0`.
// -----------------------------------------------------------------------------

esl_keepClassesOn()
{
	return getDvarInt( "esl_keep_classes" ) != 0;
}


esl_archiveId()
{
	id = self getGuid();
	safe = true;			// a guid and an xuid are hex, a player name is not

	if ( !isDefined( id ) || id == "" )
		id = self getXuid();

	if ( !isDefined( id ) || id == "" )
	{
		id   = self.name;
		safe = false;
	}

	if ( !isDefined( id ) || id == "" )
		return "";

	id  = toLower( id );
	out = "";
	i   = 0;

	// getSubStr's THIRD ARGUMENT IS AN END INDEX, NOT A LENGTH.  Measured on a live
	// server (docs/DIAGNOSTICS.md):
	//
	//     getSubStr( "abcdef", 0, 1 ) == "a"      ( "abcdef".size == 6 )
	//     getSubStr( "abcdef", 1, 1 ) == ""
	//     getSubStr( "abcdef", 1, 3 ) == "bc"
	//
	// So a one-character slice is ( i, i + 1 ).  Passing 1 for every i - which is
	// what "one character at i" reads like - returns "" from i = 1 on, so every
	// archive id came out as the FIRST character of the guid: bbdb7963f59fc1ec
	// produced "esl_class_b_sniper".  Two players whose guids began with the same
	// character then shared one archive dvar, and the second one to commit a class
	// overwrote the first one's.
	while ( i < 40 )
	{
		c = getSubStr( id, i, i + 1 );

		if ( c == "" )
			break;

		// a dvar name only takes word characters; the filter is here because the
		// fallback can be a player name
		if ( safe || isSubStr( "0123456789abcdefghijklmnopqrstuvwxyz", c ) )
			out = out + c;

		i++;
	}

	return out;
}


esl_archiveName( type )
{
	id = esl_archiveId();

	if ( id == "" || !isDefined( type ) || type == "" )
		return "";

	return "esl_class_" + id + "_" + type;
}


esl_archiveTypeName()
{
	id = esl_archiveId();

	if ( id == "" )
		return "";

	return "esl_type_" + id;
}


esl_archiveWrite( type )
{
	if ( !esl_keepClassesOn() )
		return;

	name = esl_archiveName( type );

	if ( name == "" )
		return;

	slot = esl_classTypeSlot( type );

	if ( slot < 0 || !isDefined( self.eslClasses[slot] ) )
		return;

	keys = esl_mirrorKeys();
	out  = "";

	for ( i = 0; i < keys.size; i++ )
	{
		value = self.eslClasses[slot][keys[i]];

		if ( !isDefined( value ) || value == "" )
			value = "none";

		if ( i > 0 )
			out = out + "|";

		out = out + value;
	}

	setDvar( name, out );

	// the name carries the archive id, so this is the line to read when the id
	// (and with it the whole "does a class survive a restart" chain) is in doubt
	esl_log( "archive: " + type + " saved as " + name );
}


esl_archiveTypeWrite( type )
{
	if ( !esl_keepClassesOn() )
		return;

	name = esl_archiveTypeName();

	if ( name != "" )
	{
		setDvar( name, type );

		esl_log( "archive: type " + type + " saved as " + name );
	}
}


esl_archiveTypeRead()
{
	if ( !esl_keepClassesOn() )
		return "";

	name = esl_archiveTypeName();

	if ( name == "" )
		return "";

	type = getDvar( name );

	// anything unrecognised is ignored, so a hand-written dvar cannot put the
	// player into a class type that does not exist
	if ( esl_classTypeSlot( type ) < 0 )
		return "";

	return type;
}


// Fills one class type from the archive.  True when the archive had it.
esl_archiveRead( type, slot )
{
	if ( !esl_keepClassesOn() )
		return false;

	name = esl_archiveName( type );

	if ( name == "" )
		return false;

	packed = getDvar( name );

	if ( packed == "" )
		return false;

	keys   = esl_mirrorKeys();
	values = strTok( packed, "|" );

	if ( values.size != keys.size )
		return false;

	for ( i = 0; i < keys.size; i++ )
	{
		self.eslClasses[slot][keys[i]] = values[i];

		// the level store too: that is what the rest of this map reads, including
		// the next round's spawn
		esl_storeSet( slot, keys[i], values[i] );
	}

	esl_log( "archive: " + type + " restored (" + values.size + " fields)" );

	return true;
}


// The class type in use.
//
// The type the player *committed* wins over the entity field on purpose: merely
// opening the editor and looking at another type - which the class list does on
// its own when it opens - must not change what the next spawn builds.  That is
// how a class came back as the assault default (M4 and a USP) after the specops
// class (UMP45 and a gold Deagle) had been chosen.
esl_memoryType()
{
	stored = esl_storeTypeGet();

	if ( stored != "" )
		return stored;

	if ( isDefined( self.eslClassType ) )
		return self.eslClassType;

	if ( isDefined( self.pers["esl_type"] ) && self.pers["esl_type"] != "" )
		return self.pers["esl_type"];

	// A new level: the store is empty and this is a fresh entity, so the class
	// the player committed on the previous map comes from the archive dvar.
	archived = esl_archiveTypeRead();

	if ( archived != "" )
	{
		self.eslClassType = archived;
		return archived;
	}

	return "";
}


// Mirrors the class only when it is the one in use: the sanitiser walks all 18
// The playerdata key for one field of one ESL class.
//
// Per slot, not "the class in use": the mirror was a single set of keys, so
// seeding a *different* type from it copied the equipped class into that type's
// slot - opening the sniper editor showed the UMP45 equipped in specops.
esl_persKey( slot, key )
{
	return "esl_" + slot + "_" + key;
}


// stored classes on every spawn, and the other two do not need copying.
esl_mirrorClass( classIndex )
{
	if ( !isDefined( self.eslClassType ) )
		return;

	if ( classIndex != esl_classTypeSlot( self.eslClassType ) )
		return;

	esl_mirrorActiveClass();
}


esl_mirrorActiveClass()
{
	if ( !isDefined( self.eslClassType ) )
		return;

	slot = esl_classTypeSlot( self.eslClassType );

	if ( slot < 0 )
		return;

	esl_cacPrepare( slot );

	// The loadout is mirrored for whichever type is open in the editor - those
	// edits should be kept - but deliberately *not* the type itself: that is
	// committed by esl_menuAcceptClass() only.
	keys = esl_mirrorKeys();

	for ( i = 0; i < keys.size; i++ )
	{
		value = self.eslClasses[slot][keys[i]];

		esl_storeSet( slot, keys[i], value );

		self.pers[ esl_persKey( slot, keys[i] ) ] = value;
	}

	// the copies above die with the level, the archive dvar does not
	esl_archiveWrite( self.eslClassType );
}


// Rebuilds the type memory and the working copy from the durable one.  Returns
// true when something had to be restored, i.e. when the entity had lost it.
esl_restoreActiveClass()
{
	type = esl_memoryType();

	if ( type == "" )
		return false;

	restored = false;

	if ( !isDefined( self.eslClassType ) )
	{
		self.eslClassType = type;
		restored = true;
	}

	slot = esl_classTypeSlot( type );

	if ( slot < 0 )
		return restored;

	if ( !isDefined( self.eslClasses ) )
		self.eslClasses = [];

	if ( !isDefined( self.eslClasses[slot] ) )
	{
		self.eslClasses[slot] = [];
		restored = true;
	}

	keys = esl_mirrorKeys();

	for ( i = 0; i < keys.size; i++ )
	{
		// playerdata first: it is the copy that survives a level change, the level
		// store does not (see esl_cacPrepare)
		stored = undefined;

		if ( isDefined( self.pers[ esl_persKey( slot, keys[i] ) ] ) )
			stored = self.pers[ esl_persKey( slot, keys[i] ) ];
		else
			stored = esl_storeGet( slot, keys[i] );

		if ( !isDefined( stored ) )
			continue;

		if ( self.eslClasses[slot][keys[i]] != stored )
			restored = true;

		self.eslClasses[slot][keys[i]] = stored;

		// keep both copies in step for the rest of this level
		esl_storeSet( slot, keys[i], stored );
	}

	// Neither copy had anything, and this loop has just created an *empty*
	// working copy - so esl_cacPrepare() will not run its own archive fallback
	// (it sees self.eslClasses[slot] as defined).  That is the map-change case
	// exactly: fresh level, new entity, nothing in the playerdata.  Without this
	// the spawn after a map change still built the type defaults.
	if ( !isDefined( self.eslClasses[slot][keys[0]] ) )
		esl_archiveRead( type, slot );

	return restored;
}


// --- accessors called by the patched _class.gsc -------------------------------

esl_cacWeapon( classIndex, weaponIndex )
{
	esl_cacPrepare( classIndex );

	return self.eslClasses[classIndex]["weapon" + weaponIndex];
}


esl_cacAttachment( classIndex, weaponIndex, attachmentIndex )
{
	esl_cacPrepare( classIndex );

	return self.eslClasses[classIndex]["attachment" + weaponIndex + "_" + attachmentIndex];
}


esl_cacCamo( classIndex, weaponIndex )
{
	esl_cacPrepare( classIndex );

	return self.eslClasses[classIndex]["camo" + weaponIndex];
}


esl_cacPerk( classIndex, perkIndex )
{
	esl_cacPrepare( classIndex );

	return self.eslClasses[classIndex]["perk" + perkIndex];
}


esl_cacOffhand( classIndex )
{
	esl_cacPrepare( classIndex );

	return self.eslClasses[classIndex]["offhand"];
}


// ESL never plays with deathstreaks.
esl_cacDeathstreak( classIndex )
{
	return "specialty_null";
}


// --- writers used by the editor and the sanitiser -----------------------------

esl_setStoredWeapon( classIndex, weaponIndex, value )
{
	esl_cacPrepare( classIndex );
	self.eslClasses[classIndex]["weapon" + weaponIndex] = value;

	esl_mirrorClass( classIndex );
}


esl_setStoredAttachment( classIndex, weaponIndex, attachmentIndex, value )
{
	esl_cacPrepare( classIndex );
	self.eslClasses[classIndex]["attachment" + weaponIndex + "_" + attachmentIndex] = value;

	esl_mirrorClass( classIndex );
}


esl_setStoredPerk( classIndex, perkIndex, value )
{
	esl_cacPrepare( classIndex );
	self.eslClasses[classIndex]["perk" + perkIndex] = value;

	esl_mirrorClass( classIndex );
}


esl_setStoredOffhand( classIndex, value )
{
	esl_cacPrepare( classIndex );
	self.eslClasses[classIndex]["offhand"] = value;

	esl_mirrorClass( classIndex );
}


// =============================================================================
//  RULE LOOKUPS
// =============================================================================

esl_attachmentAllowed( attachment )
{
	switch ( attachment )
	{
		case "none":
			// "no attachment" is always legal - it is entry 1 of every popup,
			// so rejecting it made "1. None" un-clickable.
			return true;

		case "silencer":
			return getDvarInt( "esl_attach_silencer" ) != 0;

		case "acog":
			return getDvarInt( "esl_attach_acog" ) != 0;

		case "reflex":
			return getDvarInt( "esl_attach_reflex" ) != 0;

		case "eotech":
			return getDvarInt( "esl_attach_eotech" ) != 0;

		case "thermal":
			return getDvarInt( "esl_attach_thermal" ) != 0;

		case "grip":
			return getDvarInt( "esl_attach_grip" ) != 0;

		case "gl":
			return getDvarInt( "esl_attach_gl" ) != 0;

		case "shotgun":
			return getDvarInt( "esl_attach_shotgun" ) != 0;

		case "heartbeat":
			return getDvarInt( "esl_attach_heartbeat" ) != 0;

		case "fmj":
			return getDvarInt( "esl_attach_fmj" ) != 0;

		case "rof":
			return getDvarInt( "esl_attach_rof" ) != 0;

		case "xmags":
			return getDvarInt( "esl_attach_xmags" ) != 0;

		case "akimbo":
			return getDvarInt( "esl_attach_akimbo" ) != 0;

		case "tactical":
			return getDvarInt( "esl_attach_tactical" ) != 0;
	}

	// Anything unknown (including future/renamed attachments) is not allowed.
	return false;
}


// The lethal's mp/statsTable.csv key.  The equipment slot value carries the
// "_mp" suffix, the stats table (and therefore the popup's info window, which
// looks the icon up in it) does not.
esl_lethalStatsRef( equipment )
{
	if ( equipment == "throwingknife_mp" )
		return "throwingknife";

	return "frag_grenade";
}


esl_equipmentAllowed( equipment )
{
	switch ( equipment )
	{
		case "specialty_null":
			return true;

		case "frag_grenade_mp":
			return getDvarInt( "esl_allow_frag_grenade" ) != 0;

		case "semtex_mp":
			return getDvarInt( "esl_allow_semtex" ) != 0;

		case "throwingknife_mp":
			return getDvarInt( "esl_allow_throwingknife" ) != 0;

		case "claymore_mp":
			return getDvarInt( "esl_allow_claymore" ) != 0;

		case "c4_mp":
			return getDvarInt( "esl_allow_c4" ) != 0;

		case "specialty_blastshield":
			return getDvarInt( "esl_allow_blastshield" ) != 0;

		case "specialty_tacticalinsertion":
			return getDvarInt( "esl_allow_tacticalinsertion" ) != 0;
	}

	return false;
}


// The value the loadout panel shows next to a grenade icon: how many the player
// gets, or 0 when the ruleset does not allow it at all.
esl_grenadeCount( allowed, count )
{
	if ( !allowed )
		return 0;

	return count;
}


esl_offhandAllowed( offhand )
{
	switch ( offhand )
	{
		case "none":
			return true;

		case "flash_grenade":
			return getDvarInt( "esl_allow_flash_grenade" ) != 0;

		case "smoke_grenade":
			return getDvarInt( "esl_allow_smoke_grenade" ) != 0;

		case "concussion_grenade":
			return getDvarInt( "esl_allow_concussion_grenade" ) != 0;
	}

	return false;
}


esl_weaponBanned( weapon )
{
	denyList = getDvar( "esl_weapon_denylist" );

	if ( !isDefined( denyList ) || denyList == "" )
		return false;

	tokens = strTok( denyList, "," );

	for ( index = 0; index < tokens.size; index++ )
	{
		if ( toLower( tokens[index] ) == toLower( weapon ) )
			return true;
	}

	return false;
}


// A slot that is emptied with "specialty_null" would be replaced by the game
// with the CLASS_DEFAULT entry of mp/classtable.csv, which would silently hand
// out an item the server just banned.  Substituting an allowed item instead
// keeps the fallback from ever running.
esl_defaultEquipment()
{
	// The lethal grenade of the equipment slot (perk slot 0).  NOTE: the
	// editor's "4. Grenade" entry is the *special* grenade popup (flash, smoke)
	// and maps to the offhand, so this is the only place the lethal is chosen.
	//
	// "esl_default_equipment" overrides everything when it is set; otherwise the
	// first allowed entry below wins, and frag comes first.
	preferred = getDvar( "esl_default_equipment" );

	if ( isDefined( preferred ) && preferred != "" )
		return preferred;

	if ( getDvarInt( "esl_allow_frag_grenade" ) )
		return "frag_grenade_mp";

	if ( getDvarInt( "esl_allow_semtex" ) )
		return "semtex_mp";

	if ( getDvarInt( "esl_allow_blastshield" ) )
		return "specialty_blastshield";

	if ( getDvarInt( "esl_allow_claymore" ) )
		return "claymore_mp";

	if ( getDvarInt( "esl_allow_c4" ) )
		return "c4_mp";

	if ( getDvarInt( "esl_allow_throwingknife" ) )
		return "throwingknife_mp";

	if ( getDvarInt( "esl_allow_tacticalinsertion" ) )
		return "specialty_tacticalinsertion";

	return "specialty_null";
}


esl_defaultOffhand()
{
	if ( getDvarInt( "esl_allow_flash_grenade" ) )
		return "flash_grenade";

	if ( getDvarInt( "esl_allow_smoke_grenade" ) )
		return "smoke_grenade";

	if ( getDvarInt( "esl_allow_concussion_grenade" ) )
		return "concussion_grenade";

	return "none";
}


// =============================================================================
//  WATCHDOG
//
//  Re-asserts the native game dvars and periodically re-checks every stored
//  class, which closes the window between a client editing its classes and the
//  next spawn.
// =============================================================================

esl_watchdog()
{
	level endon( "game_ended" );

	// Stay completely out of the way until the level is up and running: writing
	// player state while the level loads is what crashed the engine before.
	wait 10.0;

	// Prove the level thread is alive before anything else can go quiet.
	if ( esl_debugOn() )
		esl_heartbeat();

	beats = 0;

	for ( ;; )
	{
		if ( !esl_enabled() )
		{
			wait 1.0;
			continue;
		}

		esl_applyNativeDvars();

		// level.classMap is a stock variable the engine rebuilds; the ESL entries
		// have to be put back or every loadout is built from the class table
		esl_ensureCacClasses();
		esl_enforceAllClasses();

		// the stored classes are re-checked on the slower interval
		for ( index = 0; index < level.players.size; index++ )
		{
			player = level.players[index];

			if ( esl_isActivePlayer( player ) )
				player thread esl_sanitizeStoredClasses();
		}

		interval = getDvarFloat( "esl_sanitize_interval" );

		if ( interval <= 0 )
			interval = 5;

		// The class is re-asserted every second in between, because a round
		// transition must not leave the player on the engine's stock class until
		// the next sanitiser pass.  This path needs neither the entity nor any
		// notify - which is the whole point, see esl_enforceClass().
		for ( step = 0; step < interval; step++ )
		{
			wait 1.0;

			if ( !esl_enabled() )
				break;

			esl_applyNativeDvars();
			esl_enforceAllClasses();

			if ( esl_debugOn() )
				esl_traceChanges();
		}
	}
}


// Prints the state line whenever anything in it changes.
//
// A periodic pulse is useless here: the interesting moment is the round
// transition, and what matters is the *order* the fields change in - the engine's
// class going back to a vanilla one, the loadout fields being reset, the type
// staying put.  One line per change gives that order without flooding.
esl_traceChanges()
{
	for ( index = 0; index < level.players.size; index++ )
	{
		player = level.players[index];

		if ( !esl_isActivePlayer( player ) )
			continue;

		line = player maps\mp\gametypes\_globallogic::esl_heartbeatLine();

		if ( !isDefined( level.eslTrace ) )
			level.eslTrace = [];

		if ( isDefined( level.eslTrace[ player ] ) && level.eslTrace[ player ] == line )
			continue;

		level.eslTrace[ player ] = line;

		// Both channels: the HUD shows it while it happens, the client console
		// (Shift+~) keeps the scrollback, which is the only way to read the order
		// of events back after a round transition.
		player iPrintLnBold( "^3[ESL]^7 " + line );
		player iprintln( "^3[ESL]^7 " + line );
	}
}


// One line every ten seconds, on screen.
//
// Without it a dead level thread and a quiet one are indistinguishable from the
// outside - the console is not readable on this setup - so this reports that the
// watch dog runs, whether the rule set is considered enabled, and the class type
// the durable copy holds for the player.
esl_heartbeat()
{
	for ( index = 0; index < level.players.size; index++ )
	{
		player = level.players[index];

		if ( !esl_isActivePlayer( player ) )
			continue;

		player iPrintLnBold( "^3[ESL]^7 " + player maps\mp\gametypes\_globallogic::esl_heartbeatLine() );
	}
}


// What the heartbeat reports: the rule set state, what the durable copy says,
// what the engine's own fields say, and what the ESL storage holds for the slot
// in use.  "?" is an undefined or empty value - esl_show() exists so a missing
// field is visible instead of failing to concatenate.
esl_heartbeatLine()
{
	type = esl_memoryType();
	name = esl_classTypeName( type );
	slot = esl_classTypeSlot( type );

	expected = "?";

	if ( slot >= 0 )
		expected = esl_show( esl_cacWeapon( slot, 0 ) );

	return "en=" + int( esl_enabled() )
		+ " type=" + esl_show( type )
		+ " cls=" + esl_show( self.pers["class"] )
		+ " self=" + esl_show( self.class )
		+ " exp=" + expected
		+ " cw=" + esl_show( self getCurrentWeapon() )
		+ " name=" + esl_show( name );
}


esl_show( value )
{
	if ( !isDefined( value ) || value == "" )
		return "?";

	return value + "";
}


// Applies the committed ESL class with the engine's own weapon primitives,
// without going through _class::giveLoadout().
//
// giveLoadout() stays the first choice - it is what a spawn uses and it does the
// bookkeeping the rest of the game reads - but on this setup a round transition
// ended with the engine's default weapons in hand whatever the class said, and
// every request to giveLoadout() (ours included) left no trace of having run.
// This applies the durable copy directly instead: buildWeaponName() is the
// engine's own name builder, so attachments come out right.
esl_applyLoadoutNow()
{
	slot = esl_classTypeSlot( esl_memoryType() );

	if ( slot < 0 )
		return;

	primary   = esl_cacWeapon( slot, 0 );
	secondary = esl_cacWeapon( slot, 1 );

	if ( primary == "" )
		return;

	primaryName   = self maps\mp\gametypes\_class::buildWeaponName( primary, esl_cacAttachment( slot, 0, 0 ), esl_cacAttachment( slot, 0, 1 ) );
	secondaryName = self maps\mp\gametypes\_class::buildWeaponName( secondary, esl_cacAttachment( slot, 1, 0 ), esl_cacAttachment( slot, 1, 1 ) );

	// the camo index comes from the same table _class::giveLoadout() uses
	primaryCamo   = int( tableLookup( "mp/camoTable.csv", 1, esl_cacCamo( slot, 0 ), 0 ) );
	secondaryCamo = int( tableLookup( "mp/camoTable.csv", 1, esl_cacCamo( slot, 1 ), 0 ) );

	self takeAllWeapons();

	self _giveWeapon( primaryName, primaryCamo );
	self _giveWeapon( secondaryName, secondaryCamo );

	lethal = esl_cacPerk( slot, 0 );

	if ( isDefined( lethal ) && lethal != "" )
		self _giveWeapon( lethal, 0 );

	tactical = esl_cacOffhand( slot );

	if ( isDefined( tactical ) && tactical != "" )
		self _giveWeapon( tactical, 0 );

	self switchToWeapon( primaryName );
}


esl_isActivePlayer( player )
{
	if ( !isDefined( player ) )
		return false;

	if ( !isDefined( player.pers["team"] ) )
		return false;

	if ( player.pers["team"] != "allies" && player.pers["team"] != "axis" )
		return false;

	return true;
}


// Is the player holding something the class says they should have?
//
// getCurrentWeapon() carries the attachments and the "_mp" suffix, so the base
// name is matched as a prefix followed by "_" - that also keeps "m4" from
// matching "m40a3_mp".
esl_holdingExpected( primary, secondary, offhand, equipment )
{
	current = self getCurrentWeapon();

	// "no idea" is not "wrong": while dead, spectating or mid-throw there is no
	// weapon to judge, and rebuilding then would fight the game for nothing.
	if ( !isDefined( current ) || current == "" || current == "none" )
		return true;

	// The bomb is a weapon and it belongs to no class: the carrier holds it while
	// walking to the site and while planting, so it must never look like "the
	// wrong weapon" - that is what cancelled the plant.
	if ( isSubStr( current, "bomb" ) || isSubStr( current, "briefcase" ) )
		return true;

	if ( primary != "" && current == primary + "_mp" )
		return true;

	if ( primary != "" && isSubStr( current, primary + "_" ) )
		return true;

	if ( secondary != "" && isSubStr( current, secondary + "_" ) )
		return true;

	// the tactical, and the lethal - the lethal lives in the equipment slot
	if ( offhand != "" && isSubStr( current, offhand ) )
		return true;

	if ( equipment != "" && isSubStr( current, equipment ) )
		return true;

	return false;
}


esl_enforceAllClasses()
{
	for ( index = 0; index < level.players.size; index++ )
	{
		player = level.players[index];

		if ( !esl_isActivePlayer( player ) )
			continue;

		player esl_enforceClass();
	}
}


// Puts the committed class back when the engine has replaced it.
//
// A round transition hands the player the engine's stock class, and nothing on
// the spawn side could be relied on to notice: the per-player monitors were gone
// with the previous entity and no spawn-time ESL code ran afterwards at all -
// the first spawn printed its line, later ones printed nothing.  This is called
// from the level watchdog, so it needs neither the entity nor a notify, and it
// is cheap enough to run every second.
esl_enforceClass()
{
	type = esl_memoryType();

	if ( type == "" )
		return;

	name = esl_classTypeName( type );

	if ( name == "" )
		return;

	slot = esl_classTypeSlot( type );

	// A class change made while alive is meant to take effect at the next spawn;
	// until then the old weapons are the right ones to hold.
	if ( isDefined( self.eslPendingClass ) )
		return;

	// Never touch a player who is busy with the objective: the rebuild takes every
	// weapon away for a moment, which cancels a plant or a defuse - "I can't plant
	// the bomb" was exactly this, triggered by the per-second enforcement.
	if ( isDefined( self.isPlanting ) && self.isPlanting )
		return;

	if ( isDefined( self.isDefusing ) && self.isDefusing )
		return;

	// Re-seed the working copy from the playerdata mirror on every pass: after a
	// level change the level store is empty while the mirror still holds the class
	// the player chose, and without this the storage comes back as the type
	// default - an M4 for assault, which is what was being handed out.
	esl_restoreActiveClass();

	// The class *name* can be right while the loadout was built from the class
	// table instead - that is what happened when level.classMap lost the ESL
	// entries: an M4 and a USP, a healthy heartbeat and no error anywhere.
	//
	// The weapon in hand is the only trustworthy source here.  self.loadoutPrimary
	// is what the *last* giveLoadout() wrote, so it still names the ESL weapon
	// while the engine has already handed out its own default - comparing it
	// reports "all good" in exactly the broken case.
	if ( isDefined( self.pers["class"] ) && self.pers["class"] == name && isDefined( self.class ) && self.class == name )
	{
		// A weapon that is not part of the class is only a fault just after a
		// spawn: the engine has built the loadout then, so a mismatch means it
		// built the wrong one (the class-table fallback).  Later in the round it
		// means the player *picked something up* - a team-mate's or the enemy's
		// weapon, which the rules allow and which must not be taken away.
		// Repairing that handed back the class weapons and destroyed the pickup,
		// which is what "I picked up a UMP as the sniper class and it restored my
		// class" was.  Pickups are therefore left alone; the class itself is still
		// re-asserted above, every pass, whenever the engine has reset it.
		if ( !isDefined( self.eslLoadoutGraceUntil ) || getTime() > self.eslLoadoutGraceUntil )
		{
			// One line per life, so a report can show what was deliberately left
			// alone rather than only what was corrected.
			if ( !isDefined( self.eslPickupLogged ) )
			{
				primary = esl_cacWeapon( slot, 0 );

				if ( !esl_holdingExpected( primary, esl_cacWeapon( slot, 1 ), esl_cacOffhand( slot ), esl_cacPerk( slot, 0 ) ) )
				{
					self.eslPickupLogged = true;
					esl_log( "pickup: holding " + self getCurrentWeapon() + " on " + name + " - left as it is" );
				}
			}

			return;
		}

		primary   = esl_cacWeapon( slot, 0 );
		secondary = esl_cacWeapon( slot, 1 );
		offhand   = esl_cacOffhand( slot );
		equipment = esl_cacPerk( slot, 0 );

		if ( primary == "" )
			return;

		if ( esl_holdingExpected( primary, secondary, offhand, equipment ) )
			return;

		// dead is not a mismatch: the weapon in hand only means anything alive
		if ( !isAlive( self ) )
			return;

		// Safety valve: never apply the same repair more than once every five
		// seconds.  Without it a state that cannot be fixed - a player holding
		// nothing while the engine is still arming them, say - means a rebuild per
		// second, which the player sees as the class being "applied every second".
		if ( isDefined( self.eslLastRepair ) && getTime() - self.eslLastRepair < 5000 )
			return;

		self.eslLastRepair = getTime();

		// console only: a repair is worth a line, but not a message across the
		// screen in the middle of a round
		self iprintln( "^3[ESL]^7 loadout restored: " + primary );
		esl_log( "enforceClass: holding " + self getCurrentWeapon() + " -> " + primary );

		// direct application: giveLoadout() is the path that already failed here
		self thread esl_applyLoadoutNow();

		return;
	}

	self.eslClassType = type;

	esl_restoreActiveClass();

	self.pers["class"] = name;
	self.class = name;

	// console only: the player-facing notice for a corrected class is the
	// "[ESL-MOD] your class was adjusted" line in esl_reapplyLoadout()
	self iprintln( "^3[ESL]^7 class restored: " + name );
	esl_log( "enforceClass: " + name );

	if ( isAlive( self ) )
		self thread esl_reapplyLoadout();
}


// =============================================================================
//  IN-GAME CREATE A CLASS
//
//  The menus shipped in ui_mp/ (changeclass_mw, changeclass_marines_mw,
//  changeclass_opfor_mw) give the player the create-a-class editor inside a
//  match, ProMod style.  The editor talks to the server purely through
//  scriptMenuResponse commands:
//
//      assault / specops / sniper            pick a class type
//      loadout_primary:<weapon>              pick the primary
//      loadout_primary_attachment:<g>:<att>  pick its attachment
//      loadout_secondary:<weapon>            pick the sidearm
//      loadout_secondary_attachment:<g>:<att>pick the sidearm attachment
//      loadout_grenade:<grenade>             pick the tactical grenade
//      loadout_camo:<camo>                   pick the camo
//      start                                 accept the class
//      back                                  cancel
//
//  Items the player may not use are greyed out in the menu by client dvars
//  pushed from here (weap_allow_<x>, attach_allow_<group>_<x> and
//  allies_allow_<type> / axis_allow_<type>), and every accepted value is
//  validated again on the server.
//
//  A class type is stored in one of the vanilla custom-class slots so that the
//  stock _class::giveLoadout() still applies it - the class system itself is
//  untouched:
//
//      assault -> index 15 ("custom_esl_assault")
//      specops -> index 16 ("custom_esl_specops")
//      sniper  -> index 17 ("custom_esl_sniper")
//
//  The loadouts live in script data (self.eslClasses), never in the vanilla
//  custom-class playerdata, so the main-menu create-a-class cannot influence
//  them and the ESL editor cannot modify the vanilla classes.
// =============================================================================

// --- class types -------------------------------------------------------------

esl_classTypes()
{
	// NOTE: built with explicit indexing - the GSC compiler rejects an array
	// literal in a return statement ("bad syntax").
	types = [];
	types[0] = "assault";
	types[1] = "specops";
	types[2] = "sniper";

	return types;
}


// The ESL class indices.  Indices 0-14 are the vanilla classes (custom1-10 and
// class0-14 both land in that range), so the ESL types live above them and can
// never collide with a class the player owns.  This index is also what the
// patched _class.gsc uses to recognise an ESL class.
esl_classTypeSlot( classType )
{
	slot = -1;

	switch ( classType )
	{
		case "assault":
			slot = 15;
			break;

		case "specops":
			slot = 16;
			break;

		case "sniper":
			slot = 17;
			break;
	}

	return slot;
}


// The class type for an ESL class index - the reverse of esl_classTypeSlot(),
// used by the class archive.
esl_slotType( slot )
{
	if ( slot == esl_classTypeSlot( "assault" ) )
		return "assault";

	if ( slot == esl_classTypeSlot( "specops" ) )
		return "specops";

	if ( slot == esl_classTypeSlot( "sniper" ) )
		return "sniper";

	return "";
}


// Registers the ESL classes with the class system.  Called on every use rather
// than at init so it cannot be lost to script load order.
esl_ensureCacClasses()
{
	if ( !isDefined( level.classMap ) )
		level.classMap = [];

	level.classMap["custom_esl_assault"] = 15;
	level.classMap["custom_esl_specops"] = 16;
	level.classMap["custom_esl_sniper"] = 17;
}


// The ESL class index for a class name, without consulting level.classMap.
//
// giveLoadout() resolves its class through _class::getClassIndex(), which reads
// level.classMap - a stock level variable that the engine rebuilds.  The stock
// entries come back and ours do not, and then the class *name* is still right
// while the loadout is built from the class table instead: an M4 and a USP after
// a round transition, with the heartbeat still reporting type=specops and nothing
// looking wrong.  The generated _class.gsc asks this first, so the ESL classes do
// not depend on that variable at all.
esl_indexForClassName( className )
{
	if ( !isDefined( className ) )
		return -1;

	if ( className == esl_classTypeName( "assault" ) )
		return esl_classTypeSlot( "assault" );

	if ( className == esl_classTypeName( "specops" ) )
		return esl_classTypeSlot( "specops" );

	if ( className == esl_classTypeName( "sniper" ) )
		return esl_classTypeSlot( "sniper" );

	return -1;
}


// The name the rest of the game sees for an ESL class.  It has to contain
// "custom": _class::giveLoadout() tests isSubstr( class, "custom" ) to pick its
// custom-class branch, and that is the branch the ESL accessors are patched into.
esl_classTypeName( classType )
{
	if ( esl_classTypeSlot( classType ) < 0 )
		return "";

	esl_ensureCacClasses();

	return "custom_esl_" + classType;
}


// --- menu plumbing -----------------------------------------------------------

// Precaches the ESL menus and re-asserts the game[] keys the stock menu code
// uses to open them.  Cheap and idempotent; the generated _menus.gsc sets the
// same keys in its own init(), this just gets them in place as early as
// possible.
esl_menuInit()
{
	game["menu_changeclass_allies"] = "changeclass_marines_mw";
	game["menu_changeclass_axis"]   = "changeclass_opfor_mw";
	game["menu_changeclass"]        = "changeclass_mw";

	precacheMenu( "changeclass_marines_mw" );
	precacheMenu( "changeclass_opfor_mw" );
	precacheMenu( "changeclass_mw" );
}


// The five menu callbacks are replaced with these wrappers (see
// _globallogic.gsc::SetupCallbacks).  Each one gives the ESL editor first go at
// the response and otherwise forwards it to the stock handler.
esl_menuClass( response )
{
	esl_menuInit();

	if ( self esl_menuResponse( response ) )
		return;

	self maps\mp\gametypes\_menus::menuClass( response );
}


esl_menuAllies( response )
{
	if ( self esl_menuResponse( response ) )
		return;

	self maps\mp\gametypes\_menus::menuAllies( response );
}


esl_menuAxis( response )
{
	if ( self esl_menuResponse( response ) )
		return;

	self maps\mp\gametypes\_menus::menuAxis( response );
}


esl_menuAutoAssign( response )
{
	if ( self esl_menuResponse( response ) )
		return;

	self maps\mp\gametypes\_menus::menuAutoAssign( response );
}


esl_menuSpectator( response )
{
	if ( self esl_menuResponse( response ) )
		return;

	self maps\mp\gametypes\_menus::menuSpectator( response );
}


// Returns true when the response belonged to the ESL create-a-class system.
esl_menuResponse( response )
{
	// _teams.gsc calls these callbacks as [[level.allies]]() with no argument
	if ( !isDefined( response ) )
		return false;

	if ( !esl_enabled() )
		return false;

	if ( !isDefined( self.pers["team"] ) )
		return false;

	if ( self.pers["team"] != "allies" && self.pers["team"] != "axis" )
		return false;

	// Class type chosen in the class list.
	if ( esl_classTypeSlot( response ) >= 0 )
	{
		self thread esl_menuSelectClass( response );
		return true;
	}

	// An item was picked in the editor.
	if ( isSubStr( response, "loadout_" ) )
	{
		esl_processLoadoutResponse( response );
		return true;
	}

	// "start" accepts the class, "go" is the UI asking for a redraw, "back"
	// closes the editor again.
	if ( response == "start" )
	{
		self thread esl_menuAcceptClass();
		return true;
	}

	// "go" is just the UI asking for the popup to be (re)drawn - nothing to do
	if ( response == "go" )
		return true;

	if ( response == "back" && isDefined( self.eslEditorOpen ) && self.eslEditorOpen )
	{
		self.eslEditorOpen = false;
		self closepopupMenu();
		self closeInGameMenu();
		return true;
	}

	return false;
}


// Entry point for the patched _menus.gsc::onMenuResponse().
//
// The generated _menus.gsc does two things ProMod's does:
//   1. it points game["menu_changeclass_allies"|"_axis"|""] at
//      changeclass_marines_mw / changeclass_opfor_mw / changeclass_mw, which is
//      what makes the vanilla "Choose Class" button - and beginClassChoice(),
//      called whenever a player has to pick a class after joining or switching
//      sides - open the ESL class list; and
//   2. it hands every response produced by those three menus to this function
//      instead of walking its stock if/else chain.
//
// The response protocol is the one the shipped menus send:
//      class list   "assault" | "specops" | "sniper"   -> open the editor
//                   "killspec"                        -> switch to spectators
//                   "back"                            -> ESC: leave the list
//      editor       "loadout_primary:<weapon>"         -> pick a weapon
//                   "loadout_primary_attachment:<group>:<attachment>"
//                   "loadout_secondary:<weapon>"
//                   "loadout_secondary_attachment:<group>:<attachment>"
//                   "loadout_grenade:<offhand>"
//                   "loadout_camo:<camo>"
//                   "start"                           -> accept the class
//                   "back"                            -> back to the class list
//                   "go"                              -> UI redraw, ignore
esl_handleCacResponse( menu, response )
{
	if ( !esl_enabled() )
		return;

	if ( !isDefined( menu ) || !isDefined( response ) )
		return;

	if ( !isDefined( self.pers["team"] ) )
		return;

	// spectator/referee keep the stock menus
	if ( self.pers["team"] != "allies" && self.pers["team"] != "axis" )
		return;

	// ---- the class list: a class type was picked ----------------------------
	if ( menu == "changeclass_marines_mw" || menu == "changeclass_opfor_mw" )
	{
		// "4. Spectate Team" - no stock script handles "killspec"
		if ( response == "killspec" )
		{
			self thread esl_menuKillspec();
			return;
		}

		// ESC.  The class list's onEsc block sends "back" (the same response the
		// stock menus send), and onMenuResponse() hands every response of these
		// three menus to this function instead of walking its own chain - and
		// that chain is where "back" is turned into "close the popup and the
		// in-game menu".  Nothing here handled it, so ESC closed nothing while
		// the on-screen Back button kept working: that button does
		// "action { close self; }" in UI script and never involves the server.
		if ( response == "back" )
		{
			self.eslEditorOpen = false;
			self closepopupMenu();
			self closeInGameMenu();
			return;
		}

		if ( esl_classTypeSlot( response ) < 0 )
			return;

		// inline, not threaded: this is the same place ProMod opens the editor
		// from, and opening a menu from a thread races with the response loop
		// that is still unwinding - which is what made the click appear to be
		// ignored until it was pressed again
		esl_menuSelectClass( response );
		return;
	}

	if ( menu != "changeclass_mw" )
		return;

	// ---- the editor --------------------------------------------------------

	// "go" is the UI asking to be redrawn - nothing to do
	if ( response == "go" )
		return;

	// onEsc in the editor: drop back to the class list
	if ( response == "back" )
	{
		self closepopupMenu();
		self closeInGameMenu();
		self thread esl_openClassList();
		return;
	}

	// "6. Start!" accepts the edited class
	if ( response == "start" )
	{
		self thread esl_menuAcceptClass();
		return;
	}

	if ( isSubStr( response, "loadout" ) )
	{
		esl_processLoadoutResponse( response );
		return;
	}
}


// Opens the class list for the player's team.
esl_openClassList()
{
	team = self.pers["team"];

	if ( !isDefined( team ) )
		return;

	if ( team != "allies" && team != "axis" )
		return;

	self openpopupMenu( game["menu_changeclass_" + team] );
}


// The class list's "Spectate Team" entry.  The stock scripts never handle the
// "killspec" response (there is no reference to it anywhere in the game's
// scripts), which is why ProMod implements the behaviour itself - so does this,
// by delegating to the stock spectator handler.
esl_menuKillspec()
{
	team = self.pers["team"];

	if ( !isDefined( team ) )
		return;

	if ( team != "allies" && team != "axis" )
		return;

	// Let the stock handler do the work: it sets switching_teams / joining_team /
	// leaving_team, calls self addToTeam( "spectator" ) - which is the part that
	// actually transfers the player - clears the class and spawns the spectator.
	// Doing it by hand leaves the player dead on their old team, because nothing
	// calls addToTeam(), and spawnSpectator() on its own does not move them.
	self maps\mp\gametypes\_menus::menuSpectator();
}


// Opens the editor for a class type, loading that type's current loadout into
// the client dvars the UI reads.
esl_menuSelectClass( classType )
{
	self.eslClassType = classType;
	self.eslEditorOpen = true;

	// Visible, because this function can be reached without the player asking
	// for it: opening the class list sends a type response for whatever entry is
	// focused, and that must not be mistaken for a choice.
	if ( esl_debugOn() )
	{
		self iPrintLnBold( "^3[ESL]^7 editor: " + classType );
		esl_log( "editor: " + classType );
	}

	slot = esl_classTypeSlot( classType );

	// Only the cheap half runs here.  The rest of the availability push is flood
	// protected (it waits between dvars, or the engine drops the 'vdr' commands),
	// and running it inline delayed the editor by about two seconds - which read
	// as "the click did nothing, press again".
	esl_pushClassAvailability();

	self setClientDvar( "loadout_class", classType );

	// the class list compares loadout_curclass against the response it sends
	// ("assault", ...), so it holds the type - not the internal class name
	self setClientDvar( "loadout_curclass", classType );

	// publish the stored loadout so the editor shows the current values
	weapon = self maps\mp\gametypes\_class::cac_getWeapon( slot, 0 );
	if ( isDefined( weapon ) && weapon != "" )
		self setClientDvar( "loadout_primary", weapon );

	att = self maps\mp\gametypes\_class::cac_getWeaponAttachment( slot, 0 );
	self setClientDvar( "loadout_primary_attachment", esl_dvarSafe( att ) );

	sidearm = self maps\mp\gametypes\_class::cac_getWeapon( slot, 1 );
	if ( isDefined( sidearm ) && sidearm != "" )
		self setClientDvar( "loadout_secondary", sidearm );

	// The two lines of stats the editor draws under the buttons.
	esl_publishWeaponStats();

	att = self maps\mp\gametypes\_class::cac_getWeaponAttachment( slot, 1 );
	self setClientDvar( "loadout_secondary_attachment", esl_dvarSafe( att ) );

	grenade = self maps\mp\gametypes\_class::cac_getOffhand( slot );
	self setClientDvar( "loadout_grenade", esl_dvarSafe( grenade ) );

	camo = self maps\mp\gametypes\_class::cac_getWeaponCamo( slot, 0 );
	self setClientDvar( "loadout_camo", esl_dvarSafe( camo ) );

	// The lethal slot: publish the current choice and the two gates here as well,
	// synchronously - the threaded availability push can lose a client command to
	// the engine's flood protection, and losing this one greys the whole lethal
	// popup out.
	lethal = self maps\mp\gametypes\_class::cac_getPerk( slot, 0 );
	self setClientDvar( "loadout_lethal", esl_dvarSafe( lethal ) );

	// The lethal popup's info window shows the item the highlight dvar points
	// at, so point it at the current choice - otherwise it opens showing the
	// first entry regardless of what the player is actually carrying.
	self setClientDvar( "loadout_lethal_icon", esl_lethalStatsRef( lethal ) );
	self setClientDvar( "ui_sgrenade_highlighted", esl_lethalStatsRef( lethal ) );
	self setClientDvar( "lethal_allow_frag", int( esl_equipmentAllowed( "frag_grenade_mp" ) != 0 ) );
	self setClientDvar( "lethal_allow_knife", int( esl_equipmentAllowed( "throwingknife_mp" ) != 0 ) );

	self closepopupMenu();
	self closeInGameMenu();
	self openpopupMenu( game["menu_changeclass"] );

	// Finish the availability push in the background.  The editor's weapon and
	// attachment popups only read these dvars when the player opens one, so they
	// do not have to be in place before the editor appears.
	self thread esl_pushAvailability();
}


esl_dvarSafe( value )
{
	if ( !isDefined( value ) || value == "" )
		return "none";

	return value;
}


// -----------------------------------------------------------------------------
//  Weapon stats for the class editor
//
//  The editor shows two lines per slot under its buttons, and they cannot be
//  built in the menu: a menu text is a literal, a dvar or a table cell, and a
//  table cell turned out to be unusable for this.  A cell carrying a '|' comes
//  back split at the pipe (so "Primary | DMG: 40 - 30 | ..." arrived as column 1
//  = "Primary" and column 2 = the damage pair), and a plain cell drawn on its own
//  rendered nothing at all - the footer's values simply never appeared while its
//  literals did.
//
//  So the wording is composed here, where a string is just a string, and pushed
//  to the client as dvars that the menu reads with dvarString() - the same route
//  loadout_primary and every other value the editor shows already takes.
//
//  esl_weaponStatLineA/B below are generated by tools\build.ps1 step 2d from the
//  weapon files that are about to be packed, so the numbers are the match's own.
// -----------------------------------------------------------------------------
esl_publishWeaponStats()
{
	if ( !isDefined( self.eslClassType ) )
		return;

	slot = esl_classTypeSlot( self.eslClassType );

	primary   = self maps\mp\gametypes\_class::cac_getWeapon( slot, 0 );
	secondary = self maps\mp\gametypes\_class::cac_getWeapon( slot, 1 );

	if ( esl_debugOn() )
		esl_log( "stats: primary=" + primary + " secondary=" + secondary );

	self setClientDvars(
		"esl_stats_primary",   esl_statSafe( esl_weaponStatLineAll( primary ) ),
		"esl_stats_secondary", esl_statSafe( esl_weaponStatLineAll( secondary ) ) );
}


// The two generated halves as one line: the damage pair and the head multiplier,
// then the range and the rate of fire, two spaces apart - that is what the editor
// draws under each slot's name.
esl_weaponStatLineAll( weapon )
{
	first  = esl_weaponStatLine( weapon, 1 );
	second = esl_weaponStatLine( weapon, 2 );

	if ( first == "" )
		return second;

	if ( second == "" )
		return first;

	return first + "  " + second;
}


// A weapon the stats do not know is shown as "-" rather than as "none".
esl_statSafe( value )
{
	if ( !isDefined( value ) || value == "" )
		return "-";

	return value;
}


esl_weaponStatLine( weapon, part )
{
	if ( !isDefined( weapon ) || weapon == "" )
		return "";

	if ( part == 2 )
		return esl_weaponStatLineB( weapon );

	return esl_weaponStatLineA( weapon );
}


// [esl-stats:begin]
esl_weaponStatLineA( weapon )
{
	return "";
}


esl_weaponStatLineB( weapon )
{
	return "";
}
// [esl-stats:end]


// Applies the edited class: the class type's slot is selected through the stock
// class system, so giveLoadout() does the actual work.
esl_menuAcceptClass()
{
	self.eslEditorOpen = false;

	if ( !isDefined( self.eslClassType ) )
		return;

	name = esl_classTypeName( self.eslClassType );

	if ( name == "" )
		return;

	self.pers["class"] = name;
	self.class = name;

	// This is the commit.  From here the durable copy decides what a spawn
	// builds, and looking at another type in the editor cannot move it.
	esl_storeTypeSet( self.eslClassType );
	self.pers["esl_type"] = self.eslClassType;

	// The archive dvar mirrors what the copies above hold, so the class comes
	// back by itself when the next map loads.  esl_mirrorActiveClass() below
	// writes the loadout half of it.
	esl_archiveTypeWrite( self.eslClassType );

	if ( esl_debugOn() )
		esl_log( "commit " + self.eslClassType + " archived" );

	esl_mirrorActiveClass();

	if ( esl_debugOn() )
	{
		self iPrintLnBold( "^3[ESL]^7 committed: " + self.eslClassType );
		esl_log( "commit: " + self.eslClassType + " -> " + name );
	}

	self setClientDvar( "loadout_curclass", self.eslClassType );

	self closepopupMenu();
	self closeInGameMenu();

	self maps\mp\gametypes\_class::setClass( name );

	// setClass() writes the raw class name into loadout_curclass, so put the
	// type back - the class list compares that dvar with the type names
	self setClientDvar( "loadout_curclass", self.eslClassType );

	// Same rules as the stock class menu, so a class picked in the middle of a
	// life behaves exactly like the vanilla one:
	//
	//   * during the pre-match grace period (and if the player has not fought
	//     yet) the loadout is rebuilt on the spot - that is what the grace
	//     period is for;
	//   * while alive and past it, only a message is printed: applying the
	//     loadout here would hand out new weapons mid-life;
	//   * while dead, nothing has to happen - the respawn builds the loadout
	//     from self.pers["class"], which was set above;
	//   * outside a running game (pre-match class choice) the client spawns.
	if ( self.sessionstate == "playing" )
	{
		if ( !isDefined( self.pers["team"] ) || self.pers["team"] == "spectator" )
			return;

		if ( level.inGracePeriod && !self.hasDoneCombat )
		{
			self maps\mp\gametypes\_class::giveLoadout( self.pers["team"], name, false );
		}
		else if ( isAlive( self ) )
		{
			// Deferred to the next spawn, exactly like the stock menu.  The flag
			// tells the per-second enforcement that the weapons in hand are the
			// *correct* ones for the rest of this life - without it the new class
			// was applied mid-life, which is what "choosing sniper while alive
			// gives me a sniper immediately" was.
			self.eslPendingClass = name;

			self iPrintLnBold( game["strings"]["change_class"] );
		}
	}
	else
	{
		self maps\mp\gametypes\_playerlogic::spawnClient();
	}

	// The bracket holds what _class::giveLoadout() is about to read: the class
	// name it was given, the ESL class index it resolves to, and the primary
	// weapon in the ESL storage.  If the player still spawns with an M4 while
	// this shows anything other than "m4", the storage is fine and the engine's
	// own isValidPrimary()/isItemUnlocked() check is what replaced the loadout.
	if ( getDvarInt( "esl_notify" ) )
		self iprintln( "^2[ESL-MOD]^7 class set to ^3" + self.eslClassType + "^7 [" + name + " #" + esl_classTypeSlot( self.eslClassType ) + " " + esl_cacWeapon( esl_classTypeSlot( self.eslClassType ), 0 ) + "]" );
}


// --- editor responses --------------------------------------------------------

// loadout_primary:ak47 / loadout_primary_attachment:assault:silencer / ...
esl_processLoadoutResponse( response )
{
	if ( !isDefined( self.eslClassType ) )
		return;

	slot = esl_classTypeSlot( self.eslClassType );

	if ( slot < 0 )
		return;

	tokens = strTok( response, ":" );

	if ( !isDefined( tokens[0] ) || !isDefined( tokens[1] ) )
		return;

	key   = tokens[0];
	value = tokens[1];

	switch ( key )
	{
		case "loadout_primary":
			if ( esl_weaponBanned( value ) )
			{
				esl_rejectItem( "weapon", value );
				return;
			}

			esl_setStoredWeapon( slot, 0, value );
			self setClientDvar( "loadout_primary", value );

			// keep the stats lines in step with what the player picks
			esl_publishWeaponStats();

			self iprintln( "^2[ESL]^7 primary -> " + value );

			// Snipers: the Intervention (cheytac) takes FMJ and Extended Mags,
			// the M40A3 takes no attachment at all.  Drop a stored attachment
			// the new weapon cannot take and refresh the dvars the popup gates
			// the entries on.
			if ( !esl_sniperAllowsAttachments( value ) && esl_getStoredAttachment( slot, 0, 0 ) != "none" )
			{
				esl_setStoredAttachment( slot, 0, 0, "none" );
				self setClientDvar( "loadout_primary_attachment", "none" );
			}

			self setClientDvar( "attach_allow_sniper_fmj", int( esl_attachmentAllowed( "fmj" ) != 0 && esl_sniperAllowsAttachments( value ) != 0 ) );
			self setClientDvar( "attach_allow_sniper_xmags", int( esl_attachmentAllowed( "xmags" ) != 0 && esl_sniperAllowsXmags( value ) != 0 ) );

			return;

		case "loadout_secondary":
			if ( esl_weaponBanned( value ) )
			{
				esl_rejectItem( "weapon", value );
				return;
			}

			esl_setStoredWeapon( slot, 1, value );
			self setClientDvar( "loadout_secondary", value );

			// keep the stats lines in step with what the player picks
			esl_publishWeaponStats();

			// Visible in chat: proves whether the side-arm popup's response
			// reached the server at all, which is the first thing to rule out
			// when "the item I clicked was not applied".
			self iprintln( "^2[ESL]^7 side arm -> " + value );

			// The gold Deagle takes no attachment at all, and the Deagle and the
			// Magnum take FMJ but not Extended Mags.  Drop what the new side arm
			// cannot carry: leaving it in place made the game fall back to its
			// default pistol, which is what "gold Deagle + FMJ gives a USP" was.
			if ( !esl_pistolAllowsAttachments( value ) )
			{
				if ( esl_getStoredAttachment( slot, 1, 0 ) != "none" )
				{
					esl_setStoredAttachment( slot, 1, 0, "none" );
					self setClientDvar( "loadout_secondary_attachment", "none" );
				}
			}
			else if ( !esl_pistolAllowsXmags( value ) && esl_getStoredAttachment( slot, 1, 0 ) == "xmags" )
			{
				esl_setStoredAttachment( slot, 1, 0, "none" );
				self setClientDvar( "loadout_secondary_attachment", "none" );
			}

			// Both switches have to be read here: attachOk/xmagsOk are locals of
			// esl_pushAvailability(), and GSC rejects a variable that is used
			// before it is assigned *in this function* ("uninitialised variable
			// 'attachok'"), which is how this line broke the whole mod's load.
			attachOk = esl_attachmentAllowed( "fmj" ) != 0;
			xmagsOk  = esl_attachmentAllowed( "xmags" ) != 0;

			self setClientDvar( "attach_allow_pistol_fmj", int( attachOk && esl_pistolAllowsAttachments( value ) != 0 ) );
			self setClientDvar( "attach_allow_pistol_xmags", int( xmagsOk && esl_pistolAllowsXmags( value ) != 0 ) );

			return;

		case "loadout_primary_attachment":
			esl_acceptAttachment( slot, 0, tokens, "loadout_primary_attachment" );
			return;

		case "loadout_secondary_attachment":
			esl_acceptAttachment( slot, 1, tokens, "loadout_secondary_attachment" );
			return;

		case "loadout_grenade":
			if ( !esl_offhandAllowed( value ) )
				esl_rejectItem( "grenade", value );
			else
			{
				esl_setStoredOffhand( slot, value );
				self setClientDvar( "loadout_grenade", value );
			}

			return;

		case "loadout_lethal":
			// The lethal slot is the equipment slot (perk 0): the frag grenade,
			// or the throwing knife when the ruleset allows it.
			if ( !esl_equipmentAllowed( value ) )
			{
				esl_rejectItem( "lethal", value );
				return;
			}

			esl_setStoredPerk( slot, 0, value );
			self setClientDvar( "loadout_lethal", value );

			// The loadout panel draws the lethal icon from loadout_lethal_icon, and
			// the popup's info window follows ui_sgrenade_highlighted.  Both are
			// published here as well as on editor open, so the icon follows the
			// choice immediately instead of only at the next open.
			self setClientDvar( "loadout_lethal_icon", esl_lethalStatsRef( value ) );
			self setClientDvar( "ui_sgrenade_highlighted", esl_lethalStatsRef( value ) );

			// Printed (with esl_notify) so the console log shows whether the
			// popup's response reaches the server at all.
			if ( getDvarInt( "esl_notify" ) )
				self iprintln( "^2[ESL-MOD]^7 lethal set to ^3" + value );

			return;

		case "loadout_camo":
			esl_setStoredCamo( slot, 0, value );
			self setClientDvar( "loadout_camo", value );
			return;
	}
}


// attachment responses carry the weapon group as a second field:
// "loadout_primary_attachment:assault:silencer"
esl_acceptAttachment( slot, weaponIndex, tokens, dvarName )
{
	if ( !isDefined( tokens[2] ) )
		return;

	group      = tokens[1];
	attachment = tokens[2];

	if ( !esl_attachmentAllowed( attachment ) )
	{
		esl_rejectItem( "attachment", attachment );
		return;
	}

	esl_setStoredAttachment( slot, weaponIndex, 0, attachment );
	self setClientDvar( dvarName, attachment );
}


esl_rejectItem( kind, value )
{
	if ( getDvarInt( "esl_notify" ) )
		self iprintln( "^1[ESL-MOD]^7 " + kind + " ^3" + value + "^7 is not allowed" );
}


// --- availability dvars ------------------------------------------------------

// -----------------------------------------------------------------------------
//  Availability dvars
//
//  The shipped menus grey an entry out - and refuse to action it - unless the
//  matching client dvar is set:
//
//      allies_allow_<type> / axis_allow_<type>   class list entries
//      weap_allow_<weapon>                       editor weapon popups
//      attach_allow_<group>_<attachment>         editor attachment popups
//
//  They therefore have to be in place *before* the class list is drawn, not when
//  the editor opens.  esl_prepareClassMenu() is called by the generated
//  _menus.gsc immediately before it opens the class list, both from
//  beginClassChoice() (the automatic class choice on join/side switch) and from
//  the "changeclass_marines"/"changeclass_opfor" responses.
// -----------------------------------------------------------------------------

// The latency-critical half: the six class-type dvars.  Cheap (no waits) because
// the class list greys every entry out until they are set.
esl_pushClassAvailability()
{
	if ( !esl_enabled() )
		return;

	// class types are unrestricted; add per-team limits here if you need them
	types = esl_classTypes();

	for ( i = 0; i < types.size; i++ )
	{
		self setClientDvar( "allies_allow_" + types[i], 1 );
		self setClientDvar( "axis_allow_" + types[i], 1 );
	}
}


// Called from _menus.gsc before the class list is opened.  The full push runs in
// a thread because setClientDvar is flood protected - the engine drops 'vdr'
// commands that arrive too quickly, which is what the waits in
// esl_pushAvailability() are for.
esl_prepareClassMenu()
{
	esl_pushClassAvailability();

	self thread esl_pushAvailability();
}


// The rest of the dvars, needed once a class type has been picked and the editor
// (weapon / attachment / camo popups) is on screen.
esl_pushAvailability()
{
	esl_pushClassAvailability();

	// -------------------------------------------------------------------------
	//  Everything below goes out as a handful of *batched* client commands.
	//
	//  setClientDvar sends one 'vdr' client command per dvar, and the engine
	//  drops them when they arrive too fast ("Ignoring client command 'vdr'
	//  because of flood protection").  That silently greyed individual entries
	//  out even though nothing banned them - the M40A3 was one of them.
	//  setClientDvars packs many dvars into a single command, which is how
	//  ProMod pushes its availability dvars too.
	//
	//  The weapon list below must stay in step with esl_uiWeapons().
	// -------------------------------------------------------------------------
	self setClientDvars(
		"weap_allow_m16",             int( !esl_weaponBanned( "m16" ) ),
		"weap_allow_ak47",            int( !esl_weaponBanned( "ak47" ) ),
		"weap_allow_m4",              int( !esl_weaponBanned( "m4" ) ),
		"weap_allow_famas",           int( !esl_weaponBanned( "famas" ) ),
		"weap_allow_scar",            int( !esl_weaponBanned( "scar" ) ),
		"weap_allow_tavor",           int( !esl_weaponBanned( "tavor" ) ),
		"weap_allow_fal",             int( !esl_weaponBanned( "fal" ) ),
		"weap_allow_masada",          int( !esl_weaponBanned( "masada" ) ),
		"weap_allow_fn2000",          int( !esl_weaponBanned( "fn2000" ) ),
		"weap_allow_mp5k",            int( !esl_weaponBanned( "mp5k" ) ),
		"weap_allow_uzi",             int( !esl_weaponBanned( "uzi" ) ),
		"weap_allow_ump45",           int( !esl_weaponBanned( "ump45" ) ),
		"weap_allow_kriss",           int( !esl_weaponBanned( "kriss" ) ),
		"weap_allow_ak74u",           int( !esl_weaponBanned( "ak74u" ) ),
		"weap_allow_p90",             int( !esl_weaponBanned( "p90" ) ),
		"weap_allow_m1014",           int( !esl_weaponBanned( "m1014" ) ),
		"weap_allow_spas12",          int( !esl_weaponBanned( "spas12" ) ),
		"weap_allow_ranger",          int( !esl_weaponBanned( "ranger" ) ),
		"weap_allow_model1887",       int( !esl_weaponBanned( "model1887" ) ),
		"weap_allow_cheytac",         int( !esl_weaponBanned( "cheytac" ) ),
		"weap_allow_m40a3",           int( !esl_weaponBanned( "m40a3" ) ),
		"weap_allow_beretta",         int( !esl_weaponBanned( "beretta" ) ),
		"weap_allow_coltanaconda",    int( !esl_weaponBanned( "coltanaconda" ) ),
		"weap_allow_usp",             int( !esl_weaponBanned( "usp" ) ),
		"weap_allow_deserteagle",     int( !esl_weaponBanned( "deserteagle" ) ),
		"weap_allow_deserteaglegold", int( !esl_weaponBanned( "deserteaglegold" ) ),
		// Numbers of charges, not 0/1 flags: the loadout panel prints these next to
		// the grenade icon (ProMod uses the same dvar for both).  A non-zero value
		// still reads as "allowed" for the popups that gate on dvarBool(), so one
		// dvar keeps doing both jobs - and the panel no longer showed "1" for a
		// flash grenade the player actually gets two of.
		"weap_allow_frag_grenade",    esl_grenadeCount( esl_equipmentAllowed( "frag_grenade_mp" ), 1 ),
		"weap_allow_semtex",          esl_grenadeCount( esl_equipmentAllowed( "semtex_mp" ), 1 ),
		"weap_allow_flash_grenade",   esl_grenadeCount( esl_offhandAllowed( "flash_grenade" ), 2 ),
		"weap_allow_smoke_grenade",   esl_grenadeCount( esl_offhandAllowed( "smoke_grenade" ), 1 )
	);

	// The engine drops 'vdr' client commands that arrive too fast, and three
	// batched pushes back to back are enough to lose the later ones - which
	// greys out whole menus (the lethal entries were lost this way).  The small
	// gaps keep all three; this runs in a thread, so nothing is blocked by them.
	wait 0.2;

	// Only the attachments the editor actually offers are published - "no
	// attachment", FMJ and Extended Mags - for the four weapon groups whose
	// popups exist (assault, specops, sniper, pistol).  Anything not published
	// is false, i.e. greyed out.
	attachOk = esl_attachmentAllowed( "fmj" ) != 0;
	xmagsOk  = esl_attachmentAllowed( "xmags" ) != 0;

	// the gold Deagle takes no attachment, so the pistol popup gates on this too
	pistolAttachOk = attachOk;

	primary = "";
	sidearm = "";
	if ( isDefined( self.eslClassType ) )
	{
		primary = esl_cacWeapon( esl_classTypeSlot( self.eslClassType ), 0 );
		sidearm = esl_cacWeapon( esl_classTypeSlot( self.eslClassType ), 1 );
	}

	// the Deagle, the gold Deagle and the Magnum take FMJ but not xmags
	pistolXmagsOk = xmagsOk && esl_pistolAllowsXmags( sidearm ) != 0;

	// the Intervention takes FMJ and Extended Mags, the M40A3 takes neither
	sniperAttachOk = attachOk && esl_sniperAllowsAttachments( primary ) != 0;
	sniperXmagsOk  = xmagsOk  && esl_sniperAllowsXmags( primary ) != 0;

	self setClientDvars(
		"attach_allow_assault_none",  1, "attach_allow_assault_fmj",  int( attachOk ), "attach_allow_assault_xmags", int( xmagsOk ),
		"attach_allow_specops_none",  1, "attach_allow_specops_fmj",  int( attachOk ), "attach_allow_specops_xmags", int( xmagsOk ),
		"attach_allow_sniper_none",   1, "attach_allow_sniper_fmj",   int( sniperAttachOk ), "attach_allow_sniper_xmags", int( sniperXmagsOk ),
		"attach_allow_pistol_none",   1, "attach_allow_pistol_fmj",   int( pistolAttachOk ), "attach_allow_pistol_xmags",  int( pistolXmagsOk )
	);

	wait 0.2;

	// The lethal slot (equipment / perk 0).  ESL offers the frag grenade and the
	// throwing knife, so the editor's grenade popup lists both: the two
	// "lethal_allow_*" dvars gate the entries and "loadout_lethal" carries the
	// current choice so the popup can highlight it.
	lethal = "";
	if ( isDefined( self.eslClassType ) )
		lethal = self maps\mp\gametypes\_class::cac_getPerk( esl_classTypeSlot( self.eslClassType ), 0 );

	if ( !isDefined( lethal ) || lethal == "" )
		lethal = "none";

	self setClientDvars(
		"lethal_allow_frag",  int( esl_equipmentAllowed( "frag_grenade_mp" ) != 0 ),
		"lethal_allow_knife", int( esl_equipmentAllowed( "throwingknife_mp" ) != 0 ),
		"loadout_lethal",     lethal
	);
}


// The two sniper rifles behave differently: the Intervention (cheytac) takes
// FMJ and Extended Mags, the M40A3 takes no attachment at all.  The editor
// disables its "Primary Attachment" entry for the M40A3, and these keep the
// popup's entries greyed if it is opened anyway.
esl_sniperAllowsAttachments( weapon )
{
	if ( !isDefined( weapon ) )
		return 1;

	if ( weapon == "m40a3" )
		return 0;

	return 1;
}


esl_sniperAllowsXmags( weapon )
{
	return esl_sniperAllowsAttachments( weapon ) != 0 && weapon == "cheytac";
}


// The gold Desert Eagle accepts no attachment at all in this game.  Mounting one
// leaves the class invalid, and the engine then answers with the default pistol -
// which is what "gold Deagle + FMJ gives me a USP with FMJ" actually was.  The
// editor routes that one entry straight to the attachment-less side-arm action,
// and this is the gate the class-side code uses: the stored attachment is cleared
// when the weapon cannot take it, and attach_allow_pistol_fmj is published from
// here for the side arm in use.
esl_pistolAllowsAttachments( weapon )
{
	if ( !isDefined( weapon ) )
		return 1;

	if ( weapon == "deserteaglegold" )
		return 0;

	return 1;
}


// The Deagle, the gold Deagle and the Magnum take FMJ in this game but not
// Extended Mags, so the pistol attachment popup must not offer xmags for those
// three.  esl_pushAvailability() derives attach_allow_pistol_xmags from this,
// and the side-arm response below refreshes it as soon as the weapon changes.
esl_pistolAllowsXmags( weapon )
{
	if ( !isDefined( weapon ) )
		return 1;

	if ( weapon == "deserteagle" || weapon == "deserteaglegold" || weapon == "coltanaconda" )
		return 0;

	return 1;
}


esl_uiWeapons()
{
	weapons = [];

	weapons[0]  = "m16";
	weapons[1]  = "ak47";
	weapons[2]  = "m4";
	weapons[3]  = "famas";
	weapons[4]  = "scar";
	weapons[5]  = "tavor";
	weapons[6]  = "fal";
	weapons[7]  = "masada";
	weapons[8]  = "fn2000";
	weapons[9]  = "mp5k";
	weapons[10] = "uzi";
	weapons[11] = "ump45";
	weapons[12] = "kriss";
	weapons[13] = "ak74u";
	weapons[14] = "p90";
	weapons[15] = "m1014";
	weapons[16] = "spas12";
	weapons[17] = "ranger";
	weapons[18] = "model1887";
	weapons[19] = "cheytac";
	weapons[20] = "m40a3";
	weapons[21] = "beretta";
	weapons[22] = "coltanaconda";
	weapons[23] = "usp";
	weapons[24] = "deserteagle";
	weapons[25] = "deserteaglegold";
	weapons[26] = "frag_grenade";
	weapons[27] = "semtex";
	weapons[28] = "flash_grenade";
	weapons[29] = "smoke_grenade";

	return weapons;
}


esl_uiAttachments()
{
	attachments = [];

	attachments[0]  = "none";
	attachments[1]  = "acog";
	attachments[2]  = "reflex";
	attachments[3]  = "eotech";
	attachments[4]  = "thermal";
	attachments[5]  = "grip";
	attachments[6]  = "gl";
	attachments[7]  = "shotgun";
	attachments[8]  = "heartbeat";
	attachments[9]  = "silencer";
	attachments[10] = "fmj";
	attachments[11] = "rof";
	attachments[12] = "xmags";
	attachments[13] = "akimbo";
	attachments[14] = "tactical";

	return attachments;
}


esl_setStoredCamo( classIndex, weaponIndex, value )
{
	esl_cacPrepare( classIndex );
	self.eslClasses[classIndex]["camo" + weaponIndex] = value;

	esl_mirrorClass( classIndex );
}


// Asked by the patched _class.gsc::giveLoadout() before it applies anything.
//
// The class the engine hands over can be a stale or reset one - a round
// transition is enough - and then the loadout built from it is a stock class
// while the ESL class memory still says what the player picked.  Returning the
// ESL name here makes every spawn, whatever the engine thinks the class is,
// build the class the player actually chose.  An empty string means "no ESL
// class in play", i.e. the stock behaviour.
esl_memoryClassName( player )
{
	type = esl_memoryType();

	if ( type == "" )
		return "";

	name = esl_classTypeName( type );

	if ( name == "" )
		return "";

	// Make sure the loadout behind that name is the durable one, then keep the
	// engine's own view of the class in step with ours.
	esl_restoreActiveClass();

	esl_log( "giveLoadout: type=" + type + " -> " + name );

	self.pers["class"] = name;
	self.class = name;

	return name;
}


// =============================================================================
//  END-OF-MATCH MAP VOTE
//
//  The engine picks a random entry out of sv_mapRotation when the postgame ends
//  (sv_randomMapRotation 1 in config\ESL-MOD_server.cfg).  Instead the players
//  pick: three candidates drawn from the ESL map pool plus a "Random Map" card,
//  shown in the map_vote menu.
//
//  The menu is sesh_server_v2's layout.  That mod is UI only - it ships
//  map_vote.menu, a map table, the preview images and a small fastfile with the
//  preview materials, but no script at all, and nothing in IW4x implements the
//  dvars its menu reads - so everything below is this mod's own.  The two talk
//  through client-readable server info:
//
//      server -> menu   map_vote_id_<n>     map name, a key in tables\esl_mapvote.csv
//                       map_vote_count_<n>  how many votes that candidate has
//                       esl_vote_timer      the line under the title
//      menu -> server   scriptMenuResponse "cast_vote:<slot>"
//
//  Slots 0-2 are the three candidates and 4 is "Random Map"; slot 3 is skipped
//  because those are the slot numbers sesh's menu uses.
//
//  Timing: the vote *is* the postgame.  The game's own endGame() shows the
//  scoreboard, puts the players into intermission and then calls exitLevel(),
//  which is what makes the engine rotate to the next map.  The fixed wait it used
//  to do there has been replaced by a call to esl_mapVoteEndgame() - see the
//  _gamelogic.gsc fork in tools\dev\build_payload.ps1 - so the vote can take as
//  long as it likes and the rotation still belongs to the engine.
//
//  Nothing here touches sv_dontrotate and nothing here calls exitLevel(): holding
//  the rotation and then ending the level ourselves makes the engine skip the
//  rotation and shut the server down ("Not performing map rotation as
//  sv_dontRotate is true"), which is what "the server is not responding" was.
// =============================================================================

// Called once per level from esl_start(): the dvars the menu reads and the menu
// itself have to be known before a vote can be shown.
esl_mapVoteInit()
{
	// Server info, so a single setDvar reaches every client: the cards and the
	// counts are the same for everybody (only the highlight is local).
	makeDvarServerInfo( "map_vote_id_0", "" );
	makeDvarServerInfo( "map_vote_id_1", "" );
	makeDvarServerInfo( "map_vote_id_2", "" );
	makeDvarServerInfo( "map_vote_count_0", 0 );
	makeDvarServerInfo( "map_vote_count_1", 0 );
	makeDvarServerInfo( "map_vote_count_2", 0 );
	makeDvarServerInfo( "map_vote_count_4", 0 );
	makeDvarServerInfo( "esl_vote_timer", "" );

	// 0 while the round-end scoreboard is still up, 1 once the vote is live.  The
	// menu is open from the moment the match ends - see esl_mapVoteOpenMenus() -
	// and this is what keeps the cards off the screen until the vote starts.
	makeDvarServerInfo( "esl_vote_ready", 0 );

	// The rotation the server config describes, kept once per server run.  A vote
	// that ends in "Random Map" or gets no answer at all has to fall back to that
	// pool, not to the single map the *previous* vote left in sv_mapRotation.  A
	// server dvar is the only state that outlives a level, so the backup lives in
	// one - the same trick the class archive uses.
	if ( getDvar( "esl_vote_pool" ) == "" )
	{
		setDvar( "esl_vote_pool", getDvar( "sv_mapRotation" ) );
		setDvar( "esl_vote_random", getDvar( "sv_randomMapRotation" ) );
	}

	precacheMenu( "map_vote" );
}

// The maps a vote can offer.  A map that is not installed in zone\ must never reach
// sv_mapRotation, so this is deliberately the same ten the server config's rotation
// carries - and the keys are the ones tables\esl_mapvote.csv holds, which is where
// the menu gets the preview material and the label it draws.  The build fails if the
// two lists drift apart.
//
// Two flat lists, filled index by index, and a candidate is an *index* into them.
// That is not a style choice: a pool written as "[ [ "map", "Label" ], ... ]" is a
// **script compile error: bad syntax** in this dialect - GSC has no nested array
// literals, and the game's own scripts never initialise an array with more than one
// element either, they assign into it.  One bad line here stops the whole game type
// loading, which shows up as the client dropping back to the lobby on connect.
esl_mapVoteMaps()
{
	maps = [];

	maps[0] = "mp_terminal";
	maps[1] = "mp_nightshift";
	maps[2] = "mp_boneyard";
	maps[3] = "mp_highrise";
	maps[4] = "mp_subbase";
	maps[5] = "mp_afghan";
	maps[6] = "mp_invasion";
	maps[7] = "mp_checkpoint";
	maps[8] = "mp_rundown";
	maps[9] = "mp_quarry";

	return maps;
}

// What each of those maps is announced as, in the same order.
esl_mapVoteLabels()
{
	labels = [];

	labels[0] = "Terminal";
	labels[1] = "Skidrow";
	labels[2] = "Scrapyard";
	labels[3] = "Highrise";
	labels[4] = "Sub Base";
	labels[5] = "Afghan";
	labels[6] = "Invasion";
	labels[7] = "Karachi";
	labels[8] = "Rundown";
	labels[9] = "Quarry";

	return labels;
}

esl_mapVoteSeconds()
{
	seconds = getDvarInt( "esl_mapvote_time" );

	// Unset or nonsense falls back to the default; the cap keeps a mistyped value
	// from holding the end of the match open.
	if ( seconds < 5 )
		seconds = 15;

	if ( seconds > 60 )
		seconds = 60;

	return seconds;
}

esl_mapVoteOn()
{
	// Unset means on, like the esl_ rules - but deliberately not tied to
	// esl_rules_enable: the vote is not a rule, it is how the next map is chosen.
	if ( getDvar( "esl_mapvote" ) == "" )
		return true;

	return getDvarInt( "esl_mapvote" ) != 0;
}

// Called once per level by the patched _gamelogic.gsc, at the top of
// Callback_StartGameType() - see the fork in tools\dev\build_payload.ps1.  It is
// the one thing that proves the override loaded: nothing else calls it, so if the
// flag is not set the install is running the stock end-of-match code.
esl_gameLogicLoaded()
{
	level.eslMapVoteHook = true;
}

// Called by the patched _playerlogic.gsc when a player connects - see the fork in
// tools\dev\build_payload.ps1.  Like the _gamelogic.gsc marker, it exists to be
// *read in the log*: whether that override loaded decides whether the game's own
// post-match scoreboard stands down for the vote, and there is no other way to tell.
esl_playerLogicLoaded()
{
	if ( isDefined( level.eslLoggedPlayerLogic ) )
		return;

	level.eslLoggedPlayerLogic = true;

	esl_log( "mapvote: _playerlogic.gsc override loaded (post-match scoreboard off during a vote)" );
}

// The game's own end-of-match code calls this, from endGame(), where the fixed
// postgame wait used to be.  It is the whole postgame: it waits, runs the vote and
// returns, and the two lines after the call in endGame() (level notify
// "exitLevel_called" and exitLevel( false )) are what make the engine rotate - to
// the map this put into sv_mapRotation.
esl_mapVoteEndgame()
{
	level.eslMapVoteHook = true;

	// With the vote off the postgame has to be the stock one: this call took the
	// place of the fixed wait in endGame(), so that wait is done here instead.  6 s
	// is the game's own figure for a match decided over several rounds, which is the
	// normal case; the engine rotates either way once this returns.
	if ( !esl_mapVoteOn() )
	{
		esl_log( "mapvote: off (esl_mapvote 0) - stock postgame kept" );
		wait 6;
		return;
	}

	if ( !isDefined( level.players ) || level.players.size < 1 )
		return;

	esl_mapVoteRun();
}

// How long the scoreboard is left alone before the cards appear.  The vote used
// to cover it the instant the last round ended - "it has to wait a little until
// the voting should start".
esl_mapVoteDelay()
{
	// the fallback below only has the engine's own postgame to work with
	if ( isDefined( level.eslMapVoteDelayOverride ) )
		return level.eslMapVoteDelayOverride;

	delay = getDvarInt( "esl_mapvote_delay" );

	if ( delay < 0 )
		delay = 0;

	if ( delay > 30 )
		delay = 30;

	return delay;
}

// The vote window: esl_mapvote_time, unless the fallback asked for a short one.
esl_mapVoteWindow()
{
	if ( isDefined( level.eslMapVoteOverride ) )
		return level.eslMapVoteOverride;

	return esl_mapVoteSeconds();
}

// Opens the menu on every player and starts their listener.  Called once per vote.
//
// This has to happen the moment the match ends, *before* the game's own
// end-of-match sequence puts the players into intermission: a script menu opened
// after that transition is never shown on the client at all, which is what "when
// everyone goes into spectator mode to vote map - no vote menu appears" was.  The
// endgame path therefore opens the menu here and esl_mapVoteRun() only fills the
// cards in when the vote itself starts, esl_mapvote_delay seconds later.
esl_mapVoteOpenMenus()
{
	if ( isDefined( level.eslMapVoteMenusOpen ) )
		return;

	if ( !isDefined( level.players ) || level.players.size < 1 )
	{
		esl_log( "mapvote: no players - nothing to open the menu on" );
		return;
	}

	level.eslMapVoteMenusOpen = true;

	// Read by the _playerlogic.gsc fork: while this is set that script does not put
	// the player into the intermission state and does not open the game's own
	// post-match scoreboard - the two things the vote was being covered by.
	level.eslVoteRunning = true;

	// One line per vote, and the line that tells "the player loop never ran" from
	// "the client did not show the menu".
	esl_log( "mapvote: opening the menu on " + level.players.size + " player(s)" );

	// The cards are gated on esl_vote_ready in the menu file, so during the delay
	// the players get the title and this line instead of four empty boxes.
	setDvar( "esl_vote_ready", 0 );
	setDvar( "esl_vote_timer", "Next map vote starts in a moment" );

	// The candidates are drawn here rather than when the cards appear: the menu is
	// on screen from the first frame after the end-of-match transition, and a key
	// pressed then has to count - "when pressing 1-4 nothing happens" was a vote
	// arriving while the cards were still hidden and being thrown away.
	esl_mapVoteDraw();

	// for-loops rather than foreach: this file is checked by
	// tools\dev\lint_gsc_locals.ps1, which only counts a name as assigned when it
	// is assigned explicitly (see the note at the top of that tool).
	for ( i = 0; i < level.players.size; i++ )
	{
		player = level.players[i];

		// The game's own post-match menu ("endgameupdate", see
		// _playerlogic::spawnIntermission) is opened on top of this one, and it is
		// re-opened every quarter of a second for as long as there are promotions
		// or challenges to show.  Only the top menu sees the key presses, so the
		// vote would be on screen with keys that do nothing - which is the shape
		// of "the screen came up but it would not let me vote".  These two fields
		// are the whole condition that opens it, and this loop runs before the
		// end-of-match sequence reaches that code, so clearing them keeps the
		// game's menu out of the way while the vote is up.
		player.postGamePromotion = 0;
		player.pers["postGameChallenges"] = 0;

		// The last vote's answer must not be counted in this one, and the "the
		// client showed the menu" line in the log is wanted once per vote.
		player.eslMapVoteChoice    = undefined;
		player.eslMapVoteMenuSeen  = undefined;

		player thread esl_mapVoteListen();
		player openMenu( "map_vote" );
	}
}

// Draws the three candidates and publishes them.  Called from esl_mapVoteOpenMenus()
// so the vote can be answered from the first frame the menu is on screen; the
// second call - the fallback path in esl_mapVoteWatch() goes through
// esl_mapVoteRun() - finds the candidates already there and does nothing.
esl_mapVoteDraw()
{
	if ( isDefined( level.eslMapVoteCandidates ) )
		return;

	pool       = esl_mapVoteMaps();
	candidates = [];

	// Three distinct candidates, drawn as indices into the pool.  The pool is small
	// enough that checking the ones already drawn beats keeping a used-list.
	while ( candidates.size < 3 && candidates.size < pool.size )
	{
		pick = randomInt( pool.size );

		if ( candidates.size > 0 && candidates[0] == pick )
			continue;

		if ( candidates.size > 1 && candidates[1] == pick )
			continue;

		candidates[ candidates.size ] = pick;
	}

	if ( candidates.size < 1 )
	{
		esl_log( "mapvote: no candidates - skipped" );
		return;
	}

	level.eslMapVoteCandidates = candidates;

	setDvar( "map_vote_id_0", pool[ candidates[0] ] );
	setDvar( "map_vote_id_1", pool[ candidates[1] ] );
	setDvar( "map_vote_id_2", pool[ candidates[2] ] );
	setDvar( "map_vote_count_0", 0 );
	setDvar( "map_vote_count_1", 0 );
	setDvar( "map_vote_count_2", 0 );
	setDvar( "map_vote_count_4", 0 );

	esl_log( "mapvote: " + pool[ candidates[0] ] + " / " + pool[ candidates[1] ] + " / " +
	         pool[ candidates[2] ] + " (+ random), " + esl_mapVoteWindow() + " s" );
}

// Puts the menu back up on every player.  Unlike esl_mapVoteOpenMenus() this can be
// called as often as needed: no menu survives the end-of-match transition (the
// killcam and the move to spectator mode), so the vote has to put its own back once
// the players have arrived - which is what the calls in esl_mapVoteRun() do.
//
// Nothing here closes anything: an openMenu for a menu that is already open is
// ignored by the client, so repeating this is a no-op rather than a blink.  It was
// the close-then-open round trip that made the vote flash.
esl_mapVoteShowMenus()
{
	if ( !isDefined( level.players ) )
		return;

	for ( i = 0; i < level.players.size; i++ )
		level.players[i] openMenu( "map_vote" );
}

// Keeps the menu on the players and holds them still for as long as the vote runs.
// The re-open is needed because neither the round-end nor the end-of-match sequence
// leaves a menu alone; it is an open only, never a close, so it cannot flicker, and
// it stops the moment esl_mapVoteCloseMenus() clears the flag.
//
// The input focus is a separate matter and is the player's to give: see the note in
// map_vote.menu - the keyboard only reaches a script menu once the client's own
// interface has focus, which opening the in-game menu provides.
esl_mapVoteKeepShowing()
{
	while ( isDefined( level.eslVoteRunning ) )
	{
		if ( isDefined( level.players ) )
		{
			// Keep the client out of its end-of-match UI mode as well.  The scoreboard
			// is dealt with by the sessionstate in _playerlogic.gsc, but scr_gameended
			// 1 is what the client reads to decide the match is over, and in that mode
			// it stops treating the keyboard as menu input - which is the shape of
			// "i still cant choose maps with 1-4".
			setDvar( "scr_gameended", 0 );

			for ( i = 0; i < level.players.size; i++ )
			{
				player = level.players[i];

				// The vote is the only thing the players should be doing: a spectator
				// can still move the camera and switch views, which is what "disable
				// camera movement on map voting" is about.  Re-applied every pass
				// because the end-of-match code unfreezes controls for its own ends.
				player freezeControlsWrapper( true );

				// and the client's own post-match summary must not sit above the vote
				// holding the input
				player setClientDvar( "ui_opensummary", 0 );
			}
		}

		esl_mapVoteShowMenus();
		wait 1;
	}
}

// Takes the menu down again and puts the markers back, so a later vote in the same
// level starts from scratch.
esl_mapVoteCloseMenus()
{
	// clears the flag the _playerlogic.gsc fork reads - after this the game's own
	// end-of-match screens behave exactly as they always did
	level.eslVoteRunning = undefined;

	// and tells esl_mapVoteWatch() that this match has had its vote already: the
	// vote runs before the "game_ended" notify, so the watcher would otherwise see
	// the notify of a match that has just been voted on and try again
	level.eslMapVoteDone = true;

	setDvar( "esl_vote_ready", 0 );

	for ( i = 0; i < level.players.size; i++ )
		level.players[i] closeMenu( "map_vote" );

	level.eslMapVoteMenusOpen = undefined;
}

// Safety net, and the diagnostic that makes the vote debuggable at all: with the
// _gamelogic.gsc fork in place, endGame() runs the vote and this thread only says
// so in the log - every boot, because everything else about the vote is only
// visible at the end of a match.
//
// Without the fork the end-of-match code is the stock one, which waits 3 or 6 s
// and then rotates by itself.  The vote then has to fit in there, which is what
// the fallback does: level.postGameNotifies raises the stock wait to its maximum
// of 10 s (the patched endGame() does not read that dvar at all), and the vote
// runs with 1 s of delay and a 5 s window.
esl_mapVoteWatch()
{
	wait 2;

	if ( isDefined( level.eslMapVoteHook ) )
		esl_log( "mapvote: endGame() hook loaded, the vote runs the postgame" );
	else
		esl_log( "mapvote: WARNING - the patched _gamelogic.gsc is not loaded, " +
		         "running the short fallback vote instead" );

	for ( ;; )
	{
		level waittill( "game_ended" );

		// The vote itself runs from the top of endGame(), before this notify is even
		// sent - the order is in the fork in tools\dev\build_payload.ps1 - so by the
		// time it arrives, this match has already been voted on and there is nothing
		// left to do.  What follows is the safety net for a server whose
		// end-of-match code is still the stock one: there nothing calls
		// esl_mapVoteEndgame() at all.
		if ( isDefined( level.eslMapVoteDone ) )
			continue;

		if ( isDefined( level.eslMapVoteHook ) )
			continue;

		if ( !esl_mapVoteOn() )
			continue;

		if ( !isDefined( level.players ) || level.players.size < 1 )
			continue;

		level.postGameNotifies        = 40;
		level.eslMapVoteDelayOverride = 1;
		level.eslMapVoteOverride      = 5;

		esl_mapVoteRun();
	}
}

esl_mapVoteRun()
{
	// The cards wait for the scoreboard: the players look at that first, and the
	// vote covering it the instant the last round ended is exactly what "it has to
	// wait a little until the voting should start" was.
	delay = esl_mapVoteDelay();

	if ( delay > 0 )
		wait delay;

	// Open the menu - and with it draw the candidates, because
	// esl_mapVoteOpenMenus() ends in esl_mapVoteDraw() - *before* anything tests for
	// them.  The order matters: with the test first and no open yet, the whole vote
	// was abandoned by its own "no candidates - skipped" line, which is what "there
	// is no voting at all" was.
	esl_mapVoteOpenMenus();

	// From here on the vote only keeps the menu up, the players still, and the client
	// out of its end-of-match modes.
	level thread esl_mapVoteKeepShowing();

	if ( !isDefined( level.eslMapVoteCandidates ) )
	{
		esl_log( "mapvote: no candidates - skipped" );
		esl_mapVoteCloseMenus();
		return;
	}

	level.eslMapVoteSeconds = esl_mapVoteWindow();

	// From here the cards are drawn: this is the line the menu shows them on, so
	// everything above was spent looking at the scoreboard (esl_mapvote_delay,
	// with "Next map vote starts in a moment" under the title).
	setDvar( "esl_vote_ready", 1 );

	// If the game's own post-match menu did get opened anyway, take it down now
	// that the vote is the thing on screen - only the top menu sees the keys.
	if ( isDefined( game["menu_endgameupdate"] ) )
	{
		for ( i = 0; i < level.players.size; i++ )
			level.players[i] closeMenu( game["menu_endgameupdate"] );
	}

	// The long vote sound, played from here rather than from the menu's own onOpen:
	// the menu is re-opened several times while the players arrive (see
	// esl_mapVoteKeepOpen), and this way it is heard exactly once, when the cards
	// actually appear.
	for ( i = 0; i < level.players.size; i++ )
	{
		player = level.players[i];
		player playLocalSound( "esl_vote_long" );
	}

	// The countdown is as long as the menu is up.
	for ( seconds = level.eslMapVoteSeconds; seconds > 0; seconds-- )
	{
		setDvar( "esl_vote_timer", "Vote ends in " + seconds + " s" );
		wait 1;
	}

	setDvar( "esl_vote_timer", "Vote closed" );

	// Writes sv_mapRotation (or puts the server's own rotation back for "no votes"
	// and "Random Map").  endGame() rotates from it the moment this returns.
	esl_mapVoteApply();

	// A moment to read the result - esl_mapVoteApply() prints "Next map: ..." -
	// before the cards go away and the level changes.
	wait 2;

	esl_mapVoteCloseMenus();
}

// One per player: the menu speaks through menuresponse.  The game's own menu
// handler listens for the same notify on its own thread, so this does not
// interfere with it.
esl_mapVoteListen()
{
	self endon( "disconnect" );

	// Both names are pre-assigned because of the linter: it only knows the *last*
	// argument a waittill binds, so a second one reads as "never assigned".
	menu     = "";
	response = "";

	for ( ;; )
	{
		self waittill( "menuresponse", menu, response );

		// Only the response is checked, not the menu name.  "cast_vote:" is the
		// one string this menu can produce, and requiring the engine to report the
		// menu under the same name the menu file uses is how the first version of
		// this managed to ignore every single vote.
		if ( !isSubStr( response, "cast_vote:" ) )
		{
			// "menu_opened" is sent by the menu's own onOpen, and it is the one
			// thing the server cannot see for itself.  Every one of them is logged
			// with a count: how many arrive, and when, is what says whether the
			// client took the menu and when it dropped it again - a single line
			// would have hidden exactly the behaviour that is being chased.
			if ( response == "menu_opened" )
			{
				if ( !isDefined( self.eslMapVoteMenuOpens ) )
					self.eslMapVoteMenuOpens = 0;

				self.eslMapVoteMenuOpens = self.eslMapVoteMenuOpens + 1;

				esl_log( "mapvote: " + self.name + " menu shown (" + self.eslMapVoteMenuOpens + ")" );
			}
			else if ( isSubStr( response, "key_pressed" ) )
			{
				// The execKey handlers send this before the vote itself, so the log
				// separates "the key never reached the menu" from "the menu answered
				// and the answer was not a vote".
				esl_log( "mapvote: " + self.name + " key handler fired: " + response );
			}

			continue;
		}

		// No "has the vote started yet" check: the candidates are drawn the moment
		// the menu goes up, so a key pressed as soon as the players are out of the
		// killcam is a real vote.  Ignoring those was what made voting look dead.
		slot = int( getSubStr( response, 10 ) );

		if ( slot != 0 && slot != 1 && slot != 2 && slot != 4 )
		{
			esl_log( "mapvote: ignoring '" + response + "' from " + self.name +
			         " (menu '" + menu + "')" );
			continue;
		}

		// A player may change their mind: one choice per player, the last one
		// counts, and the tally is recomputed from the players every time.
		if ( isDefined( self.eslMapVoteChoice ) && self.eslMapVoteChoice == slot )
			continue;

		self.eslMapVoteChoice = slot;

		// On the player's own screen as well as in the log.  A key press that
		// changes nothing visible reads as "it does not work" even when the vote
		// counted - the log shows exactly that happened.
		if ( slot == 4 )
			self iPrintLnBold( "Vote: Random Map" );
		else
			self iPrintLnBold( "Vote: " + esl_mapVoteLabels()[ level.eslMapVoteCandidates[ slot ] ] );

		esl_log( "mapvote: " + self.name + " votes " + slot );

		esl_mapVotePublish();
	}
}

// Recounts every player's choice and pushes the four counters to the clients.
esl_mapVotePublish()
{
	counts = [];

	// slots 0-2 are the candidates, 4 is "Random Map" (3 is unused on purpose)
	for ( i = 0; i < 5; i++ )
		counts[ i ] = 0;

	for ( i = 0; i < level.players.size; i++ )
	{
		player = level.players[i];

		if ( !isDefined( player.eslMapVoteChoice ) )
			continue;

		slot = player.eslMapVoteChoice;
		counts[ slot ] = counts[ slot ] + 1;
	}

	setDvar( "map_vote_count_0", counts[0] );
	setDvar( "map_vote_count_1", counts[1] );
	setDvar( "map_vote_count_2", counts[2] );
	setDvar( "map_vote_count_4", counts[4] );

	return counts;
}

// The winning candidate becomes the next map.
esl_mapVoteApply()
{
	counts = esl_mapVotePublish();
	slots  = [];

	slots[0] = 0;
	slots[1] = 1;
	slots[2] = 2;
	slots[3] = 4;

	best = -1;
	tied = [];

	for ( i = 0; i < slots.size; i++ )
	{
		slot = slots[i];

		if ( counts[ slot ] > best )
		{
			best = counts[ slot ];
			tied = [];
			tied[0] = slot;
		}
		else if ( counts[ slot ] == best )
		{
			tied[ tied.size ] = slot;
		}
	}

	if ( best <= 0 )
	{
		// Nobody voted.  The rotation goes back to what the server config
		// describes, which is the random pick this server used before the vote.
		esl_mapVoteRestoreRotation();
		esl_log( "mapvote: no votes - rotation back to the server's own pool" );
		return;
	}

	winner = tied[ randomInt( tied.size ) ];

	if ( tied.size > 1 )
		esl_log( "mapvote: " + tied.size + " way tie, drawing one of them" );

	if ( winner == 4 )
	{
		esl_mapVoteRestoreRotation();
		esl_log( "mapvote: random map wins (" + best + " vote(s)) - server's own pool" );
		return;
	}

	map   = esl_mapVoteMaps()[ level.eslMapVoteCandidates[ winner ] ];
	label = esl_mapVoteLabels()[ level.eslMapVoteCandidates[ winner ] ];

	// The engine's rotation reads this list when the postgame ends.  With a single
	// entry there is nothing left for it to pick at random, which is the whole
	// point: the voted map is the next map.
	setDvar( "sv_mapRotation", "gametype " + getDvar( "g_gametype" ) + " map " + map );
	setDvar( "sv_mapRotationCurrent", "" );
	setDvar( "sv_randomMapRotation", 0 );

	esl_log( "mapvote: " + map + " wins with " + best + " vote(s) -> next map" );

	for ( i = 0; i < level.players.size; i++ )
		level.players[i] iPrintLnBold( "Next map: " + label );
}

// Puts the rotation the server config gave the server back, for the two answers
// that do not name a map.  Without this the single map an earlier vote wrote into
// sv_mapRotation would stay there for the rest of the server run, and "no votes"
// would keep replaying that one map instead of the configured pool.
esl_mapVoteRestoreRotation()
{
	setDvar( "sv_mapRotation", getDvar( "esl_vote_pool" ) );
	setDvar( "sv_mapRotationCurrent", "" );

	if ( getDvar( "esl_vote_random" ) != "" )
		setDvar( "sv_randomMapRotation", getDvar( "esl_vote_random" ) );
}
