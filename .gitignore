# Build output (payload + packed iwd + the iwd audit scratch folder)
# regenerate with tools\build.ps1
build/

# Unlinked base game reference material
# (regenerate with Unlinker, see docs/DIAGNOSTICS.md)
.tmp_reference/

# Third party reference exports, read-only - the sheet this project ships is
# docs\weapon-stats.html, generated by tools\weapon-sheet.ps1
Modern Warfare 2 Weapon Stats by Marvel4 - Google Диск.html
Modern Warfare 2 Weapon Stats by Marvel4 - Google Диск_files/

# IW4x runtime junk that sometimes ends up in a mod folder
*.log
demos/
mods/

# Python bytecode from the container helper (docker/rcon.py)
__pycache__/
*.pyc

# The IW4x installation mounted into the container (docker-compose.yml maps
# it to /game).  It is game data and is never committed.
docker/game/
